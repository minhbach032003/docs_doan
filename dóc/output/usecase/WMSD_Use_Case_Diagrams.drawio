        </mxCell>
        <mxCell id="UC-24" value="UC-24&#10;Create Goods Receipt from&#10;Purchase Order" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-24" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff" description="Prepare a goods receipt referencing the purchase order and receiving results, with batch, quantity, and stock status.">
          <mxGeometry x="90.0" y="900.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-26" value="UC-26&#10;Confirm Goods Receipt" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-26" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff" description="Finalize the goods receipt and increase inventory by product, batch, and stock status.">
          <mxGeometry x="90.0" y="1030.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-27" value="UC-27&#10;Create Supplier Return Request" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-27" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Purchasing Staff, Inventory Staff" description="Request a supplier return referencing the purchase order or receiving record, batch, quantity, and return reason.">
          <mxGeometry x="90.0" y="1160.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-29" value="UC-29&#10;Confirm Supplier Return Dispatch" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-29" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff" description="Confirm actual return quantities; reduce stock only when the goods were previously received into inventory.">
          <mxGeometry x="90.0" y="1290.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-30" value="UC-30&#10;Allocate Storage Locations" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-30" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff" description="Allocate newly received goods to storage locations by batch, color code, and quantity after capacity checks.">
          <mxGeometry x="90.0" y="1490.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-31" value="UC-31&#10;Create Location Transfer" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-31" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff" description="Create a transfer document for a batch and quantity between source and destination locations in the same warehouse.">
          <mxGeometry x="90.0" y="1620.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-32" value="UC-32&#10;Confirm Location Transfer" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-32" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff" description="Confirm physical relocation, decrease the source location balance, and increase the destination location balance without changing total stock.">
          <mxGeometry x="90.0" y="1750.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-33" value="UC-33&#10;Move Goods to Pending Inspection" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-33" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff" description="Mark quantities awaiting inspection as unavailable for sales allocation.">
          <mxGeometry x="90.0" y="1880.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-34" value="UC-34&#10;Record Goods Inspection Results" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-34" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff" description="Record inspected, accepted, and rejected quantities and reasons by batch.">
          <mxGeometry x="90.0" y="2010.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-36" value="UC-36&#10;Record and Isolate Damaged Goods" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-36" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff" description="Identify affected product, batch, quantity, and location and isolate goods with quality issues.">
          <mxGeometry x="90.0" y="2140.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-38" value="UC-38&#10;View Inventory by Batch and&#10;Location" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-38" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff, Sales Staff, Store Owner" description="View quantities by product, batch, color code, storage location, and stock status.">
          <mxGeometry x="90.0" y="2270.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-39" value="UC-39&#10;Monitor Available and Reserved&#10;Inventory" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-39" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="3" sourceActors="Inventory Staff, Sales Staff" description="Distinguish physical, available, sales-reserved, and non-issuable stock.">
          <mxGeometry x="90.0" y="2400.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-40" value="UC-40&#10;Configure and Monitor Low-Stock&#10;Alerts" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-40" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="3" sourceActors="Store Owner, Inventory Staff" description="Set minimum inventory thresholds and view products below the configured levels.">
          <mxGeometry x="90.0" y="2530.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-41" value="UC-41&#10;View Inventory Transaction&#10;History" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-41" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="3" sourceActors="Inventory Staff, Store Owner" description="Trace goods receipts, issues, location transfers, stock-status changes, and inventory adjustments.">
          <mxGeometry x="90.0" y="2660.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-71" value="UC-71&#10;View Warehouse-Specific and&#10;Consolidated Inventory" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-71" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="4" sourceActors="Store Owner, Inventory Staff, Sales Staff" description="View stock by warehouse, batch, color, location, and status, with consolidated balances across warehouses.">
