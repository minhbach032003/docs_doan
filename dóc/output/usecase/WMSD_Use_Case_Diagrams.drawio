        </mxCell>
        <mxCell id="UC-74" value="UC-74&#10;Confirm Transfer Receipt" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-74" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="4" sourceActors="Inventory Staff" description="Compare quantities received with those dispatched and receive goods into the destination warehouse by batch, location, and condition.">
