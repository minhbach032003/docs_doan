          <mxGeometry x="90.0" y="3620.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-44" value="UC-44&#10;Reconcile Stocktake Variances" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-44" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="3" sourceActors="Inventory Staff" description="Compare physical counts with book stock and record discrepancies and their causes.">
          <mxGeometry x="90.0" y="3750.0" width="280" height="90" as="geometry" />
