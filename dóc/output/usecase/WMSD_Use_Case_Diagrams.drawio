        <mxCell id="UC-09" value="UC-09&#10;View and Trace Product Batch" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-09" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff, Store Owner" description="View batch details, storage locations, inventory balances, and associated transaction history.">
