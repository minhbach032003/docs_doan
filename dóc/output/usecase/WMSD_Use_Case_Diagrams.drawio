        </mxCell>
        <mxCell id="UC-21" value="UC-21&#10;Register Supplier Delivery" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-21" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff" description="Receive supplier goods and delivery documents and link them to the corresponding purchase order.">
