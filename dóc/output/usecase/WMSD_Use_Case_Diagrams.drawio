        <mxCell id="UC-22" value="UC-22&#10;Inspect Received Goods" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-22" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff" description="Count and verify product, quantity, batch number, color code, production date, and goods condition.">
          <mxGeometry x="90.0" y="640.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-23" value="UC-23&#10;Record Receiving Discrepancy" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-23" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="2" sourceActors="Inventory Staff" description="Record shortages, over-deliveries, incorrect products or batches, and broken or damaged goods.">
