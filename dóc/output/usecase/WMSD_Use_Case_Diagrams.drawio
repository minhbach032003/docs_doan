        <mxCell id="UC-07" value="UC-07&#10;Create Product Batch" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-07" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="1" sourceActors="Store Owner, Inventory Staff" description="Record batch number, product code, color code, production date, and manufacturer; validate batch uniqueness.">
