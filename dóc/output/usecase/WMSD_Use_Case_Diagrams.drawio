          <mxGeometry x="90.0" y="3940.0" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="UC-49" value="UC-49&#10;Allocate and Reserve Stock by&#10;Batch" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-49" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="3" sourceActors="Sales Staff, Inventory Staff" description="Select batches and reserve quantities for an order; indicate when multiple batches are needed.">
