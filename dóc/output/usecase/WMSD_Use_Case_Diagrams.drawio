        </mxCell>
        <mxCell id="UC-75" value="UC-75&#10;Reconcile Transfer Discrepancy" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;strokeWidth=1.3;strokeColor=#333333;spacing=8;fontFamily=Arial;fontSize=15;fontColor=#111111;fillColor=#ffffff;" vertex="1" parent="system" ucId="UC-75" provenance="source" sourceFile="Report3.docx.pdf" sourcePage="4" sourceActors="Store Owner, Inventory Staff" description="Record and resolve shortages, surpluses, or damage between transfer dispatch and receipt before closing the transfer.">
