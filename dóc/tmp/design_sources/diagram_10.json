  "uml": [
    "@startuml\ntitle 2.5 Supplier Return and Purchase Reconciliation (BF-05)\n\nscale 2000 width\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 11\nskinparam activityFontSize 11\nskinparam swimlaneWidth 320\nskinparam activityBorderColor #666666\nskinparam activityBackgroundColor #FDFDFD\nskinparam activityDiamondBackgroundColor #FFF4D6\nskinparam activityDiamondBorderColor #888888\nskinparam activityArrowColor #666666\n\n|Inventory Staff|\nstart\n:Identify defective, damaged,\\nexcess or non-conforming goods;\n:Check product, lot,\\nwarehouse and location;\n:Look up related Purchase Order\\nand Goods Receipt;\n:Enter return quantity\\nand return reason;\n:Create Supplier Return Request;\n\n|System|\n:Validate purchase reference,\\nlot and return quantity;\n\nif (Return request valid?) then (Yes)\n\n    :Create Supplier Return Request;\n    :Set status to Pending Review;\n\nelse (No)\n\n    :Reject invalid Return Request;\n    :Display validation errors;\n\n    |Inventory Staff|\n    :Review invalid return data;\n\n    stop\n\nendif\n\n\n|Accountant|\n:Review Purchase Order,\\nGoods Receipt and invoice;\n:Contact supplier\\nthrough external channel;\n:Record supplier response;\n\nif (Supplier accepts return?) then (Yes)\n\n    :Record agreed return terms;\n    :Record return method\\nand expected return date;\n\nelse (No)\n\n    :Record supplier rejection\\nand follow-up note;\n\n    |System|\n    :Set Supplier Return Request\\nas Supplier Rejected;\n    :Notify Inventory Staff\\nand Store Owner;\n\n    stop\n\nendif\n\n\n|System|\n:Submit Supplier Return Request\\nfor approval;\n\n|Store Owner|\n:Review return reason,\\nquantity and supplier agreement;\n\nif (Approve supplier return?) then (Yes)\n\n    |System|\n    :Set Supplier Return Request\\nas Approved;\n    :Notify Inventory Staff;\n\nelse (No)\n\n    |System|\n    :Set Supplier Return Request\\nas Rejected;\n    :Record rejection result;\n    :Notify Inventory Staff\\nand Accountant;\n\n    stop\n\nendif\n\n\n|Inventory Staff|\n:Review approved Return Request;\n:Locate goods by warehouse,\\nlot and storage location;\n:Pick approved goods;\n:Check actual return quantity;\n\n|System|\n:Compare actual quantity\\nwith approved quantity;\n\nif (Quantity discrepancy?) then (Yes)\n\n    |Inventory Staff|\n    :Record actual quantity;\n    :Record discrepancy reason;\n\n    |System|\n    :Calculate revised\\nreturn quantity;\n\n    |Store Owner|\n    :Review revised quantity;\n\n    if (Approve revised quantity?) then (Yes)\n\n        |System|\n        :Update approved\\nreturn quantity;\n\n    else (No)\n\n        :Set Return Request\\nto Adjustment Required;\n        :Notify Inventory Staff\\nand Accountant;\n\n        stop\n\n    endif\n\nelse (No)\n\n    |System|\n    :Keep approved\\nreturn quantity;\n\nendif\n\n\n|Inventory Staff|\n:Prepare return shipment;\n:Check product, lot,\\nquantity and packaging;\n:Confirm physical handover;\n:Confirm Supplier Return Issue;\n\n|System|\n:Validate return issue;\n:Create Return Goods Issue Note;\n:Deduct returned quantity\\nfrom warehouse stock;\n:Update inventory history;\n:Set Supplier Return Request\\nas Dispatched;\n\n\n|Accountant|\n:Track supplier return\\noffline;\n:Receive supplier acknowledgement;\n:Record acknowledged quantity;\n:Attach supporting documents;\n\n|System|\n:Compare acknowledged quantity\\nwith dispatched quantity;\n\nif (Acknowledged quantity matches?) then (Yes)\n\n    :Confirm supplier\\nreturn acknowledgement;\n\nelse (No)\n\n    |Accountant|\n    :Record acknowledgement discrepancy;\n    :Contact supplier externally;\n    :Record resolution result;\n\n    |System|\n    :Validate resolved quantity;\n\n    if (Discrepancy resolved?) then (Yes)\n\n        :Update accepted\\nreturn quantity;\n\n    else (No)\n\n        :Set Supplier Return Request\\nto Pending Reconciliation;\n        :Notify Accountant\\nand Store Owner;\n\n        stop\n\n    endif\n\nendif\n\n\n|Accountant|\n:Review final return result;\n:Review original supplier invoice;\n:Record supplier credit,\\npayable adjustment or refund;\n\n|System|\n:Update supplier payable balance;\n:Link financial adjustment\\nto Supplier Return Request;\n:Update purchase reconciliation;\n:Set Supplier Return Request\\nas Completed;\n:Update inventory and\\npayables reports;\n:Notify related staff;\n\nstop\n@enduml"
  ]
}