  "uml": [
    "@startuml\ntitle BF-01 - Replenishment, Purchasing & Goods Receiving\n\n|Accountant|\nstart\n:Review stock replenishment need;\n:Create replenishment request;\n\n|WMSD|\n:Record replenishment request;\n:Show request and current stock information;\n\n|Store Owner|\n:Review replenishment request;\n\nif (Request approved?) then (Yes)\n\n  |WMSD|\n  :Update request status to Approved;\n\n  |Accountant|\n  :Create purchase order;\n\n  |WMSD|\n  :Link purchase order to approved request;\n  :Track ordered and outstanding quantities;\n\n  |Accountant|\n  :Record supplier confirmation;\n\n  |WMSD|\n  :Update confirmed quantity\n  and expected delivery date;\n\n  |Inventory Staff|\n  :Create goods receipt from purchase order;\n  :Record actual received quantity,\n  lot and condition;\n\n  |WMSD|\n  :Compare received quantity\n  with purchase order;\n\n  |Inventory Staff|\n  :Inspect received goods;\n\n  if (Goods accepted?) then (Yes)\n\n    |WMSD|\n    :Record accepted quantity;\n\n    |Inventory Staff|\n    :Complete goods receipt;\n    :Put accepted goods away;\n\n    |WMSD|\n    :Increase inventory by lot,\n    location and status;\n    :Update outstanding purchase quantity;\n\n  else (No)\n\n    |Inventory Staff|\n    :Record discrepancy / defective goods;\n\n    |WMSD|\n    :Keep non-usable quantity\n    outside usable inventory;\n    :Record discrepancy information;\n\n  endif\n\nelse (No)\n\n  |WMSD|\n  :Update request status to Rejected;\n\nendif\n\nstop\n@enduml"
  ]
