          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml BP06_Stock_Count_Adjustment\n\ntitle BP-06 - Quy trình Kiểm kê và Điều chỉnh tồn kho\n\nscale 2000 width\n\n!pragma useVerticalIf on\n\nskinparam backgroundColor #FFFFFF\nskinparam defaultFontName Arial\nskinparam defaultFontSize 14\nskinparam shadowing false\nskinparam roundcorner 8\nskinparam wrapWidth 250\nskinparam swimlaneWidth 380\n\nskinparam activity {\n    BackgroundColor #FFFFFF\n    BorderColor #9CA3AF\n    FontColor #111827\n    ArrowColor #6B7280\n}\n\nskinparam swimlane {\n    BorderColor #9CA3AF\n    TitleBackgroundColor #E5E7EB\n}\n\n\n|Kế toán|\nstart\n:Lập kế hoạch kiểm kê;\n:Xác định phạm vi kiểm kê;\n:Thông báo thực hiện kiểm kê;\n\n\n|Nhân viên kho|\n:Chuẩn bị khu vực kiểm kê;\n:Kiểm đếm hàng hóa thực tế;\n:Ghi nhận kết quả kiểm kê;\n\n\nwhile (Kết quả kiểm đếm chưa rõ ràng?) is (Có)\n\n    :Kiểm tra lại vị trí,\\nlô và hàng hóa;\n    :Thực hiện kiểm đếm lại;\n    :Cập nhật kết quả kiểm kê;\n\nendwhile (Không)\n\n\n|Nhân viên kho|\n:Tổng hợp số lượng thực tế;\n\n\n|Kế toán|\n:Tiếp nhận kết quả kiểm kê;\n:Đối chiếu số liệu;\n\n\nwhile (Còn chênh lệch chưa xác định?) is (Có)\n\n    :Xác định mặt hàng\\nvà số lượng chênh lệch;\n\n    |Nhân viên kho|\n    :Kiểm tra lại hàng hóa,\\nlô và vị trí lưu kho;\n    :Kiểm đếm lại hàng chênh lệch;\n    :Gửi kết quả kiểm tra lại;\n\n    |Kế toán|\n    :Tiếp nhận kết quả kiểm tra;\n    :Đối chiếu lại số liệu;\n\nendwhile (Không)\n\n\n|Kế toán|\n:Lập biên bản kiểm kê;\n\n\nif (Có chênh lệch tồn kho?) then (Có)\n\n    :Xác định số lượng\\ncần điều chỉnh;\n    :Ghi nhận điều chỉnh tồn kho;\n    :Ghi nhận giá trị chênh lệch;\n    :Hoàn tất kỳ kiểm kê;\n\n    stop\n\nelse (Không)\n\n    :Xác nhận tồn kho\\nkhớp kết quả kiểm kê;\n    :Hoàn tất kỳ kiểm kê;\n\n    stop\n\nendif\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1yfFOPsddYNPeIz41Ct0-98">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
