  <diagram id="xk6cpQHHdcQcy3Xn7kZ_" name="Procurement and Inbound Receiving">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle 2.1 End-to-End Procurement and Inbound Receiving (BF-01)\n\nscale 2000 width\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 11\nskinparam activityFontSize 11\nskinparam swimlaneWidth 260\nskinparam activityBorderColor #666666\nskinparam activityBackgroundColor #FDFDFD\nskinparam activityDiamondBackgroundColor #FFF4D6\nskinparam activityDiamondBorderColor #888888\nskinparam activityArrowColor #666666\n\n|Inventory Staff|\nstart\n:Review stock level;\n\n|System|\n:Show available stock,\\nminimum level and pending inbound;\n\nif (Stock below required level?) then (Yes)\n\n    |Inventory Staff|\n    :Determine required quantity;\n    :Create Purchase Request;\n\n    |System|\n    :Validate product and quantity;\n    :Check existing open orders;\n    :Submit request to Accountant;\n\n    |Accountant|\n    :Review Purchase Request;\n\n    if (Approve request?) then (Yes)\n\n        :Select supplier;\n        :Create Purchase Order;\n        :Enter price and expected date;\n\n        |System|\n        :Validate Purchase Order;\n        :Create approved Purchase Order;\n        :Record order status;\n\n        |Accountant|\n        :Send Purchase Order to supplier\\nthrough external channel;\n        :Record supplier confirmation;\n\n        |System|\n        :Update confirmed quantity\\nand expected delivery date;\n\n        |Inventory Staff|\n        :Receive delivered goods;\n        :Open related Purchase Order;\n        :Check product and quantity;\n        :Check lot, color and condition;\n\n        |System|\n        :Compare actual receipt\\nwith Purchase Order;\n\n        if (Receiving discrepancy?) then (Yes)\n\n            |Inventory Staff|\n            :Record discrepancy;\n\n            |Accountant|\n            :Review discrepancy;\n            :Contact supplier externally;\n            :Record handling result;\n\n            |System|\n            :Update accepted and\\noutstanding quantities;\n\n        endif\n\n        |Inventory Staff|\n        :Create or select lot;\n        :Create Goods Receipt Note;\n        :Select receiving warehouse;\n        :Assign storage location;\n        :Confirm actual receipt;\n\n        |System|\n        :Validate Goods Receipt Note;\n        :Increase stock by warehouse,\\nlot and location;\n        :Update Purchase Order progress;\n        :Record inventory transaction;\n\n        |Accountant|\n        :Receive supplier invoice;\n        :Verify invoice against\\nPurchase Order and receipt;\n        :Record payable information;\n\n        |System|\n        :Update payable record;\n\n        if (Purchase Order fully received?) then (Yes)\n            :Set Purchase Order\\nas Completed;\n        else (No)\n            :Set Purchase Order\\nas Partially Received;\n        endif\n\n    else (No)\n\n        |System|\n        :Set Purchase Request\\nas Rejected;\n        :Notify Inventory Staff;\n\n    endif\n\nelse (No)\n\n    |System|\n    :No replenishment required;\n\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3ZM6WOOLKdOYoCsEEX7E-625">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
