        <UserObject label="BP-05 - Quy trình Trả hàng Nhà cung cấp" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;" plantUmlBaseValue="BP-05 - Quy trình Trả hàng Nhà cung cấp" id="1yfFOPsddYNPeIz41Ct0-97">
