  <diagram id="IQEa83IOWgTPSjGBoH08" name="Customer Return and Reverse Logistics">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle 2.4 Customer Return and Reverse Logistics (BF-04)\n\nscale 1400 width\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam activityBorderColor #666666\nskinparam activityBackgroundColor #FDFDFD\nskinparam activityDiamondBackgroundColor #FFF4D6\nskinparam activityDiamondBorderColor #888888\nskinparam activityArrowColor #666666\n\n|Sales Staff|\nstart\n:Receive customer return request\nthrough offline channels;\n:Look up original Sales Order\nand delivery information;\n:Review returned products,\nquantities, and return reasons;\n:Create Customer Return Request;\n\n|System|\n:Validate original Sales Order;\n:Check delivered quantities,\npreviously returned quantities,\nand return eligibility;\n\nif (Return request valid?) then (Yes)\n    :Save Customer Return Request;\n    :Update request status to Pending;\nelse (No)\n    :Display validation errors;\n\n    |Sales Staff|\n    :Review errors and clarify\n    return information with customer;\n    stop\nendif\n\n|Sales Staff|\n:Record expected return date\nand receiving warehouse;\n:Arrange return of goods\nto the designated warehouse;\n\n|Inventory Staff|\n:Review pending return request;\n:Receive physical returned goods;\n:Check product, quantity, lot,\npackaging, and physical condition;\n:Record inspection results;\n\n|System|\n:Compare actual returned goods\nwith original Sales Order\nand Customer Return Request;\n\nif (Receiving discrepancy found?) then (Yes)\n    |Inventory Staff|\n    :Record quantity discrepancy,\n    damaged goods, or wrong products;\n    :Provide inspection remarks;\nendif\n\n|Inventory Staff|\n:Submit return inspection results;\n\n|Store Owner|\n:Review Customer Return Request\nand inspection results;\n\nif (Approve returned goods?) then (Yes)\n    :Confirm accepted products\n    and return quantities;\n\n    |System|\n    :Record approved return quantities;\n    :Update return request status\n    to Approved;\n\n    |Inventory Staff|\n    :Confirm receipt of accepted goods;\n    :Assign receiving warehouse\n    and storage location;\n\n    |System|\n    :Generate Customer Return\n    Goods Receipt Note;\n    :Update inventory quantities\n    by warehouse, lot, and location;\n    :Move received goods\n    to Pending Inspection;\n\n    |Inventory Staff|\n    :Classify returned goods\n    according to inspection results;\n\n    if (Goods suitable for resale?) then (Yes)\n        |System|\n        :Move approved quantities\n        to Available Stock;\n    else (No)\n        |System|\n        :Move affected quantities\n        to Quarantine or Damaged Stock;\n    endif\n\n    |Accountant|\n    :Review approved return\n    and related sales documents;\n    :Record applicable receivable\n    adjustment or refund information;\n\n    |System|\n    :Update financial records;\n    :Update inventory transaction history;\n    :Update return request\n    status to Completed;\n\n    |Sales Staff|\n    :Review completed return;\n    :Inform customer of return result;\n\nelse (No)\n    |System|\n    :Update return request\n    status to Rejected;\n    :Record rejection reason;\n\n    |Sales Staff|\n    :Review rejection result;\n    :Inform customer of rejection\n    and arrange handling of goods;\n\n    |Inventory Staff|\n    :Keep rejected goods separate\n    pending return to customer;\nendif\n\n|System|\n:Update customer return history;\n:Update related Sales Order records;\n:Update inventory and sales reports;\n:Notify relevant staff;\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="sFT7cpD1ClnzBJfCD2FR-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
