  <diagram id="YGMxktGPn6WhAOxGkLHn" name="Stock Count, Reconciliation and Inventory Adjustment">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle 2.6 Stock Count, Reconciliation and Inventory Adjustment (BF-06)\n\nscale 2000 width\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 11\nskinparam activityFontSize 11\nskinparam swimlaneWidth 260\nskinparam activityBorderColor #666666\nskinparam activityBackgroundColor #FDFDFD\nskinparam activityDiamondBackgroundColor #FFF4D6\nskinparam activityDiamondBorderColor #888888\nskinparam activityArrowColor #666666\n\n|Store Owner|\nstart\n:Create Stock Count Plan;\n:Select warehouse,\\nlocation and scope;\n\n|System|\n:Create Stock Count Session;\n:Capture book stock snapshot;\n\n|Inventory Staff|\n:Perform physical count;\n:Enter actual quantity\\nby product, lot and location;\n\n|System|\n:Compare actual quantity\\nwith book quantity;\n:Calculate variance;\n\nif (Variance found?) then (Yes)\n\n    |Inventory Staff|\n    :Review variance;\n\n    if (Recount required?) then (Yes)\n\n        :Perform recount;\n        :Update actual quantity;\n\n        |System|\n        :Recalculate variance;\n\n    else (No)\n\n        |Inventory Staff|\n        :Keep current count result;\n\n    endif\n\n    |Inventory Staff|\n    :Enter variance reason;\n    :Submit count result;\n\n    |System|\n    :Record count result\\nand variance details;\n\n    |Store Owner|\n    :Review count result;\n\n    if (Approve adjustment?) then (Yes)\n\n        |System|\n        :Create approved\\nInventory Adjustment;\n\n        |Inventory Staff|\n        :Confirm Inventory Adjustment;\n\n        |System|\n        :Update stock by warehouse,\\nlot and location;\n        :Record adjustment history;\n        :Close Stock Count Session;\n\n    else (No)\n\n        |System|\n        :Return result for recount;\n\n        |Inventory Staff|\n        :Review rejected result;\n        :Perform recount;\n        :Update actual quantity;\n        :Resubmit count result;\n\n        |System|\n        :Recalculate variance;\n        :Record revised count result;\n\n    endif\n\nelse (No)\n\n    |System|\n    :Confirm no variance;\n    :Close Stock Count Session\\nwithout adjustment;\n\nendif\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-j32AQ_OwbPkN_G5dATZ-69">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
