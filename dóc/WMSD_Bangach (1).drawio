  <diagram id="YmuK2wHcZ4IODAFXEVcV" name="Sales Order Fulfillment and Delivery">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle 2.3 End-to-End Sales Order Fulfillment and Delivery (BF-03)\n\nscale 1400 width\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam activityBorderColor #666666\nskinparam activityBackgroundColor #FDFDFD\nskinparam activityDiamondBackgroundColor #FFF4D6\nskinparam activityDiamondBorderColor #888888\nskinparam activityArrowColor #666666\n\n|Sales Staff|\nstart\n:Receive customer purchase request;\n:Look up products, prices,\nand available inventory;\n\n|System|\n:Display product information,\npricing, and available stock\nby warehouse and lot;\n\n|Sales Staff|\n:Confirm order details with customer;\n:Create Sales Order;\n:Select products, quantities,\nprices, and delivery information;\n\n|System|\n:Validate Sales Order data;\n:Check available stock\nacross warehouses;\n\nif (Sufficient stock available?) then (Yes)\n    :Display eligible warehouses\n    and available lots;\nelse (No)\n    :Display stock shortage\n    and available alternatives;\n\n    |Sales Staff|\n    :Review available stock;\n    :Adjust order quantity,\n    warehouse, or delivery schedule;\n\n    |System|\n    :Revalidate Sales Order;\n\n    if (Order can be fulfilled?) then (Yes)\n        :Confirm available quantities;\n    else (No)\n        :Save Sales Order as Pending;\n        stop\n    endif\nendif\n\n|Sales Staff|\n:Allocate stock by warehouse and lot;\n:Reserve stock for Sales Order;\n\n|System|\n:Validate lot availability\nand reserved quantities;\n:Update reserved stock;\n:Generate stock allocation details;\n\n|Sales Staff|\n:Create Goods Issue Request\nfrom Sales Order;\n\n|Store Owner|\n:Review Goods Issue Request;\n\nif (Approve Goods Issue Request?) then (Yes)\n    |System|\n    :Approve Goods Issue Request;\n    :Notify assigned Inventory Staff;\nelse (No)\n    |System|\n    :Reject Goods Issue Request;\n    :Notify Sales Staff for revision;\n    stop\nendif\n\n|Inventory Staff|\n:Review approved Goods Issue Request;\n:Locate reserved stock\nby warehouse, lot, and location;\n:Pick and prepare goods;\n:Check product, lot, quantity,\npackaging, and physical condition;\n\nif (Picking discrepancy found?) then (Yes)\n    :Record shortage or damaged goods;\n\n    |System|\n    :Update picking discrepancy;\n    :Notify Sales Staff;\n\n    |Sales Staff|\n    :Review alternative stock\n    or partial fulfillment;\n\n    |System|\n    :Validate revised allocation;\n\n    |Inventory Staff|\n    :Complete picking\n    for confirmed quantities;\nendif\n\n|Inventory Staff|\n:Verify prepared shipment;\n:Confirm Goods Issue;\n\n|System|\n:Generate Goods Issue Note;\n:Deduct issued quantities\nfrom the source warehouse and lots;\n:Update reserved stock\nand inventory transaction history;\n:Update Sales Order\nfulfillment progress;\n\n|Sales Staff|\n:Create delivery batch;\n:Arrange delivery schedule\nand transportation;\n:Record shipment dispatch;\n\n|System|\n:Update delivery status\nto In Transit;\n\n|Sales Staff|\n:Record actual delivery result\nand customer handover confirmation;\n\nif (Delivery successful?) then (Yes)\n    |System|\n    :Update delivery status\n    to Delivered;\n    :Record delivered quantities;\nelse (No)\n    |Sales Staff|\n    :Record delivery shortage,\n    rejection, or failed delivery;\n    :Arrange redelivery\n    or return of undelivered goods;\n\n    |System|\n    :Update delivery exception;\n    :Track outstanding quantities\n    and required follow-up;\nendif\n\n|Sales Staff|\n:Review Sales Order\nfulfillment progress;\n\n|System|\nif (All ordered quantities fulfilled?) then (Yes)\n    :Update Sales Order\n    status to Completed;\nelse (No)\n    :Update Sales Order\n    status to Partially Fulfilled;\n    :Keep outstanding quantities\n    available for follow-up;\nendif\n\n:Update sales and inventory reports;\n:Notify related staff;\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NF0DESU0kkzWNpbHNbeN-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Sales Staff" plantUmlId="lane_224" plantUmlBaseStyle="swimlane;collapsible=0;startSize=30;fillColor=none;swimlaneFillColor=none;strokeColor=#181818;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=0;html=1;shadow=0;fontFamily=Arial;" plantUmlBaseValue="Sales Staff" id="NF0DESU0kkzWNpbHNbeN-2">
