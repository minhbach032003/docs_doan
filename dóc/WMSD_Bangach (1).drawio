  <diagram id="hg62axyphuOInY_-ZZR4" name="Multi-Warehouse Replenishment and Internal Transfer">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle 2.2 Multi-Warehouse Replenishment and Internal Transfer (BF-02)\n\nscale 1400 width\n\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam activityBorderColor #666666\nskinparam activityBackgroundColor #FDFDFD\nskinparam activityDiamondBackgroundColor #FFF4D6\nskinparam activityDiamondBorderColor #888888\nskinparam activityArrowColor #666666\n\n|System|\nstart\n:Detect stock shortage at destination warehouse\\nor branch warehouse;\n\n|Inventory Staff|\n:Review shortage and source warehouse options;\n:Create internal transfer request;\n\n|System|\n:Validate source warehouse,\\ndestination warehouse,\\navailable stock, reserved stock,\\nand requested transfer quantity;\n\n|Store Owner|\n:Review transfer request;\n\nif (Approve transfer request?) then (Yes)\n    |System|\n    :Approve internal transfer request;\n    :Generate transfer order;\nelse (No)\n    |System|\n    :Reject transfer request;\n    stop\nendif\n\n|Inventory Staff|\n:At source warehouse,\\nallocate stock by lot;\n:Pick goods from source locations;\n:Prepare transfer shipment;\n\n|System|\n:Validate picked quantity and lot allocation;\n\n|Inventory Staff|\n:Confirm transfer issue from source warehouse;\n\n|System|\n:Deduct stock from source warehouse;\n:Mark transfer as In Transit;\n\n|Inventory Staff|\n:Receive transfer shipment\\nat destination warehouse;\n:Check quantity, lot,\\nand physical condition;\n\nif (Discrepancy or damage found?) then (Yes)\n    :Record transfer discrepancy;\n\n    |Store Owner|\n    :Review discrepancy handling;\n\n    if (Accept partial receipt?) then (Yes)\n        |System|\n        :Create partial transfer receipt;\n        :Keep unresolved quantity under exception handling;\n    else (No)\n        |System|\n        :Reject affected quantity;\n        :Create return-back handling\\nfor unresolved quantity;\n    endif\nendif\n\n|Inventory Staff|\n:Assign destination storage location;\n:Create transfer receipt;\n\n|System|\n:Update stock at destination warehouse\\nas Pending Inspection or Available;\n\n|Inventory Staff|\n:Perform final inspection if required;\n\nif (Inspection passed?) then (Yes)\n    |System|\n    :Move stock to Available status;\nelse (No)\n    |System|\n    :Move stock to Quarantine status;\nendif\n\n|System|\n:Close transfer order;\n:Update transfer history and inventory logs;\n:Notify related users;\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_8qkYUaEpAjFhANIj60W-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
