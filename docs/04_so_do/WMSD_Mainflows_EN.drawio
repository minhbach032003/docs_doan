            <Array as="points">
              <mxPoint x="607" y="1208" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf02-e-6c-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf02-s6c" target="bf02-s7">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>

        <mxCell id="bf02-legend" value="Blue: action / document • Green: inventory, quarantine or scrap posting • Yellow diamond: decision branch • Red: exception / alternate outcome" style="text;align=left;fontSize=13;fontStyle=1;fontColor=#43566f;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1435" width="1200" height="28" />
        </mxCell>
        <mxCell id="bf02-note" value="&lt;b&gt;Document &amp;amp; Posting Semantics (BF-02):&lt;/b&gt; Warehouse Staff immediately blocks allocation and quarantines defective stock (&lt;b&gt;TO-QUARANTINE&lt;/b&gt;) without waiting for Store Owner approval. Quarantine/regrade preserves store-owned total stock and never transfers ownership between custody and store-owned stock. &lt;b&gt;SCRAP&lt;/b&gt; deducts store-owned stock exactly once only when actual destruction is executed with evidence (approval alone does not deduct). Approved supplier returns route to &lt;b&gt;BF-07&lt;/b&gt; and deduct once at &lt;b&gt;GI-SR&lt;/b&gt; dispatch in BF-07, never in BF-02." style="rounded=1;fillColor=#f3f5f8;strokeColor=#d6dde6;align=left;spacing=12;fontSize=13;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1470" width="1200" height="150" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="BF-03" name="BF-03">
    <mxGraphModel dx="1990" dy="2080" grid="1" gridSize="10" page="1" pageWidth="1990" pageHeight="2080" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bf03-title" value="BF-03 — Relocation (A), inter-warehouse transfer (B) and discrepancies" style="text;align=left;fontSize=24;fontStyle=1;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1910" height="42" />
        </mxCell>
        <mxCell id="bf03-subtitle" value="To-be D1–D8 • Updated 21 Oct 2026 • Authoritative specification: docs/02_nghiep_vu/de_xuat_quy_trinh_2_EN.md (Sections 4, 15, 16)" style="text;align=left;fontSize=13;fontColor=#58677c;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="64" width="1910" height="28" />
        </mxCell>
        <mxCell id="bf03-lane-sales" value="Sales Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="110" width="350" height="1710" />
        </mxCell>
        <mxCell id="bf03-lane-wh" value="Warehouse Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390" y="110" width="780" height="1710" />
        </mxCell>
        <mxCell id="bf03-lane-owner" value="Store Owner" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1170" y="110" width="370" height="1710" />
        </mxCell>
        <mxCell id="bf03-lane-dst" value="Destination Warehouse Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1540" y="110" width="410" height="1710" />
        </mxCell>

        <!-- Row 1: Trigger & Branch Decision -->
        <mxCell id="bf03-s1" value="&lt;b&gt;1. Identify movement or warehouse-shortage need&lt;/b&gt;&lt;br&gt;Check lot/tone/calibre/quality, bin suitability &amp;amp; stocktake locks&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Movement / Shortage trigger • UC-36, UC-103 [EX-04]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-wh">
          <mxGeometry as="geometry" x="55" y="66" width="320" height="88" />
        </mxCell>
        <mxCell id="bf03-d1" value="&lt;b&gt;Same-warehouse (A)&lt;br&gt;or inter-warehouse (B)?&lt;/b&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-wh">
          <mxGeometry as="geometry" x="105" y="192" width="220" height="92" />
        </mxCell>

        <!-- Row 2: Branch A (Same-warehouse relocation) -->
        <mxCell id="bf03-a1" value="&lt;b&gt;Branch A — Same-warehouse relocation [BF-03-A1]&lt;/b&gt;&lt;br&gt;Move &amp;amp; confirm: atomically post &lt;b&gt;source −q, dest +q&lt;/b&gt; in one warehouse; preserve lot/quality &amp;amp; reservations (&lt;b&gt;no TR / Owner approval&lt;/b&gt;)&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;TO-RELOCATE (CONFIRMED) • UC-36, UC-37 [BR-09]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-wh">
          <mxGeometry as="geometry" x="415" y="182" width="340" height="112" />
        </mxCell>

        <!-- Row 3: Branch B Step 1 & Direct-Dispatch Decision -->
        <mxCell id="bf03-b1" value="&lt;b&gt;B1. Check compatible stock across warehouses&lt;/b&gt;&lt;br&gt;Suggest direct dispatch or inter-warehouse transfer by simple priority &amp;amp; due date&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Fulfilment options • UC-103&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-wh">
          <mxGeometry as="geometry" x="55" y="332" width="320" height="88" />
        </mxCell>
        <mxCell id="bf03-d2" value="&lt;b&gt;Fulfilment option:&lt;br&gt;Direct dispatch?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;UC-103 [BF-03-A2]&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-sales">
          <mxGeometry as="geometry" x="70" y="330" width="210" height="92" />
        </mxCell>

        <!-- Row 4: Direct Dispatch to BF-05 vs Submit TR -->
        <mxCell id="bf03-a2" value="&lt;b&gt;[BF-03-A2] Direct dispatch via BF-05 at source warehouse&lt;/b&gt;&lt;br&gt;Confirm with customer; split OD by actual warehouse &amp;amp; execute &lt;b&gt;BF-05&lt;/b&gt; there — &lt;b&gt;NO fictitious receipt at main warehouse&lt;/b&gt; and no transit stock.&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;OD → BF-05 • UC-51, UC-103&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-sales">
          <mxGeometry as="geometry" x="20" y="465" width="290" height="110" />
        </mxCell>
        <mxCell id="bf03-b2" value="&lt;b&gt;B2. Submit inter-warehouse Transfer Request (TR)&lt;/b&gt;&lt;br&gt;Specify source/destination warehouses, lot/quality &amp;amp; quantity&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;TR • UC-40&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-wh">
          <mxGeometry as="geometry" x="55" y="474" width="320" height="88" />
        </mxCell>

        <!-- Row 5: Owner reviews TR & Decision -->
        <mxCell id="bf03-b3" value="&lt;b&gt;B3. Review &amp;amp; approve Transfer Request&lt;/b&gt;&lt;br&gt;Requester ≠ approver; reserves source stock with concurrency check (no redundant TO approval)&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;TR Approval • UC-41 [UC-42 retired]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-owner">
          <mxGeometry as="geometry" x="35" y="474" width="300" height="88" />
        </mxCell>
        <mxCell id="bf03-d3" value="&lt;b&gt;TR approved &amp;amp;&lt;br&gt;staff/stock ready?&lt;/b&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-owner">
          <mxGeometry as="geometry" x="80" y="610" width="210" height="92" />
        </mxCell>
        <mxCell id="bf03-e1" value="&lt;b&gt;[BF-03-E1] Rejected TR, freeze or no independent receiver&lt;/b&gt;&lt;br&gt;Record reason; wait or revise unexecuted scope. Never dispatch if frozen or use dispatcher as receiver." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-sales">
          <mxGeometry as="geometry" x="25" y="610" width="300" height="92" />
        </mxCell>

        <!-- Row 6: Source Pick & Dispatch (TD) -->
        <mxCell id="bf03-b4" value="&lt;b&gt;B4. Source pick, count, handover &amp;amp; post Transfer Dispatch&lt;/b&gt;&lt;br&gt;Decreases source on-hand (&lt;b&gt;−q&lt;/b&gt;) &amp;amp; increases in-transit (&lt;b&gt;+q&lt;/b&gt;) once; preserves demand allocation&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;Optional TO-PICK / TD (POSTED) + HO • UC-43 [BR-10]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-wh">
          <mxGeometry as="geometry" x="55" y="750" width="320" height="96" />
        </mxCell>

        <!-- Row 7: Independent Destination Inspection & MWTR Receipt -->
        <mxCell id="bf03-b5" value="&lt;b&gt;B5. Independently inspect &amp;amp; post transfer receipt (MWTR)&lt;/b&gt;&lt;br&gt;Receiver ≠ dispatcher; inspect lot/tone/calibre &amp;amp; quality; post verified receipt (&lt;b&gt;transit −q, dest +q by quality&lt;/b&gt;)&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;INS / MWTR (POSTED) • UC-104 [BR-11, BR-12]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-dst">
          <mxGeometry as="geometry" x="45" y="892" width="320" height="98" />
        </mxCell>

        <!-- Row 8: Discrepancy decision & Put-away -->
        <mxCell id="bf03-d4" value="&lt;b&gt;Discrepancy or&lt;br&gt;unresolved transit?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;[BF-03-E2, E3]&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-dst">
          <mxGeometry as="geometry" x="95" y="1038" width="220" height="96" />
        </mxCell>
        <mxCell id="bf03-e2" value="&lt;b&gt;[BF-03-E2 / E3] Partial, damaged, excess or wrong lot&lt;/b&gt;&lt;br&gt;E.g. TD 100 → receive 95 GOOD + 3 DAMAGED (quarantine/BF-02) → 2 stay in-transit. Record &lt;b&gt;VAR&lt;/b&gt;; no negative transit or silent substitution." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-wh">
          <mxGeometry as="geometry" x="55" y="1038" width="320" height="96" />
        </mxCell>

        <!-- Row 9: Owner approves variance resolution & Warehouse executes -->
        <mxCell id="bf03-b6" value="&lt;b&gt;B6. Approve transfer discrepancy resolution&lt;/b&gt;&lt;br&gt;Authorize additional receipt, return-to-source, quarantine or evidenced transit loss&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Resolution Approval • UC-44&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-owner">
          <mxGeometry as="geometry" x="35" y="1186" width="300" height="92" />
        </mxCell>
        <mxCell id="bf03-b7" value="&lt;b&gt;B7. Execute approved resolution documents&lt;/b&gt;&lt;br&gt;Post linked additional MWTR, return-to-source or loss movement; preserve original TD/MWTR&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;Linked MWTR / Return / Loss • UC-43, UC-44, UC-104&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-wh">
          <mxGeometry as="geometry" x="55" y="1186" width="320" height="92" />
        </mxCell>

        <!-- Row 10: Put away verified stock & Close TR/TD -->
        <mxCell id="bf03-b8" value="&lt;b&gt;B8. Put away received stock; close TR/TD when 100% accounted for&lt;/b&gt;&lt;br&gt;Confirm put-away TO; allocated stock stays reserved for customer demand&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;TO-PUTAWAY / TR &amp;amp; TD COMPLETED • UC-33, UC-39, UC-104&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf03-lane-dst">
          <mxGeometry as="geometry" x="45" y="1338" width="320" height="96" />
        </mxCell>

        <!-- Edges for BF-03 -->
        <mxCell id="bf03-e-1-d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf03-s1" target="bf03-d1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf03-e-d1-a1" value="Branch A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=12;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf03-d1" target="bf03-a1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf03-e-d1-b1" value="Branch B: Inter-warehouse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;fontSize=12;fontColor=#17304d;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf03-d1" target="bf03-b1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf03-e-b1-d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf03-b1" target="bf03-d2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf03-e-d2-a2" value="Yes (Direct dispatch)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=12;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf03-d2" target="bf03-a2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf03-e-d2-b2" value="No (Transfer needed)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;fontSize=12;fontColor=#17304d;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitPerimeter=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf03-d2" target="bf03-b2">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="385" y="509" />
              <mxPoint x="385" y="628" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf03-e-b2-b3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf03-b2" target="bf03-b3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf03-e-b3-d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf03-b3" target="bf03-d3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf03-e-d3-e1" value="No / Blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=12;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf03-d3" target="bf03-e1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf03-e-d3-b4" value="Approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=12;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf03-d3" target="bf03-b4">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1355" y="836" />
              <mxPoint x="605" y="836" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf03-e-b4-b5" value="In-transit stock" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=12;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf03-b4" target="bf03-b5">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="605" y="980" />
              <mxPoint x="1745" y="980" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf03-e-b5-d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf03-b5" target="bf03-d4">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf03-e-d4-e2" value="Yes (Variance)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=12;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf03-d4" target="bf03-e2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf03-e-e2-b6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85c5c;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf03-e2" target="bf03-b6">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="605" y="1270" />
              <mxPoint x="1355" y="1270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf03-e-b6-b7" value="Approved resolution" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=11;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf03-b6" target="bf03-b7">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf03-e-b7-b8" value="All quantities accounted for" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;fontSize=12;fontColor=#17304d;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf03-b7" target="bf03-b8">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="605" y="1496" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf03-e-d4-b8" value="No (Matched)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=12;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf03-d4" target="bf03-b8">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>

        <mxCell id="bf03-legend" value="Blue: action / document • Green: relocation, dispatch, receipt or resolution posting • Yellow diamond: decision branch • Red: exception / variance outcome" style="text;align=left;fontSize=13;fontStyle=1;fontColor=#43566f;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1835" width="1910" height="28" />
        </mxCell>
        <mxCell id="bf03-note" value="&lt;b&gt;Document &amp;amp; Posting Semantics (BF-03A &amp;amp; BF-03B):&lt;/b&gt; &lt;b&gt;Warehouse Staff&lt;/b&gt; and &lt;b&gt;Destination Warehouse Staff&lt;/b&gt; are responsibilities of the same application role (&lt;b&gt;Warehouse Staff&lt;/b&gt;), separated here to show that inter-warehouse receipt requires an independent user (&lt;b&gt;receiver ≠ dispatcher&lt;/b&gt;). &lt;b&gt;(A) Same-warehouse relocation&lt;/b&gt; uses &lt;b&gt;TO-RELOCATE&lt;/b&gt; with no TR and no Store Owner approval. &lt;b&gt;(B) Inter-warehouse fulfilment&lt;/b&gt; either dispatches directly from the other warehouse via &lt;b&gt;BF-05&lt;/b&gt; (&lt;b&gt;no fictitious receipt at the main warehouse&lt;/b&gt;) or follows &lt;b&gt;approved TR → TD (source −q, transit +q) → independent MWTR (transit −verified q, destination +q by actual quality) → TO-PUTAWAY&lt;/b&gt;. Never post GR-P for MWTR. Damaged received boxes enter quarantine (not lost transit)." style="rounded=1;fillColor=#f3f5f8;strokeColor=#d6dde6;align=left;spacing=12;fontSize=13;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1870" width="1910" height="155" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="BF-04" name="BF-04">
    <mxGraphModel dx="1280" dy="1820" grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="1820" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bf04-title" value="BF-04 — Stocktake, reconciliation and adjustment" style="text;align=left;fontSize=24;fontStyle=1;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1200" height="42" />
        </mxCell>
        <mxCell id="bf04-subtitle" value="To-be D1–D8 • Updated 21 Oct 2026 • Authoritative specification: docs/02_nghiep_vu/de_xuat_quy_trinh_2_EN.md (Sections 4, 15, 16)" style="text;align=left;fontSize=13;fontColor=#58677c;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="64" width="1200" height="28" />
        </mxCell>
        <mxCell id="bf04-lane-owner" value="Store Owner" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="110" width="460" height="1450" />
        </mxCell>
        <mxCell id="bf04-lane-wh" value="Warehouse Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="110" width="740" height="1450" />
        </mxCell>

        <!-- Row 1: Owner plans stocktake & Warehouse resolves open tasks -->
        <mxCell id="bf04-s1" value="&lt;b&gt;1. Plan stocktake session, scope &amp;amp; counters&lt;/b&gt;&lt;br&gt;Select warehouse/location/lot/status scope &amp;amp; schedule (monthly per Q14 or targeted)&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;ST PLANNED • UC-84–86&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-owner">
          <mxGeometry as="geometry" x="70" y="66" width="320" height="90" />
        </mxCell>
        <mxCell id="bf04-s2" value="&lt;b&gt;2. Resolve open tasks in scope before activation&lt;/b&gt;&lt;br&gt;Separate staged, quarantined, custody &amp;amp; transit stock; reject overlapping frozen sessions; never count transit as a bin&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Pre-cutoff check • UC-86, UC-87 [BF-04-E1]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-wh">
          <mxGeometry as="geometry" x="45" y="66" width="330" height="90" />
        </mxCell>

        <!-- Row 2: Activate immutable snapshot & freeze scope -->
        <mxCell id="bf04-s3" value="&lt;b&gt;3. Activate immutable cutoff snapshot, freeze scope &amp;amp; export blind count sheet&lt;/b&gt;&lt;br&gt;D5 MVP locks quantity/location/status movements in counted scope until session closes&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;ST FROZEN / Snapshot / COUNT sheet • UC-87, UC-105 [BR-21, BR-22]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-wh">
          <mxGeometry as="geometry" x="45" y="202" width="330" height="94" />
        </mxCell>

        <!-- Row 3: Count physical stock & A1 note -->
        <mxCell id="bf04-s4" value="&lt;b&gt;4. Count BOX/PIECE &amp;amp; condition; record attempts&lt;/b&gt;&lt;br&gt;Record user &amp;amp; timestamp; keep all recount history; blank = uncounted (never 0)&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;COUNT attempts • UC-87 [BF-04-A1]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-wh">
          <mxGeometry as="geometry" x="45" y="342" width="330" height="90" />
        </mxCell>
        <mxCell id="bf04-a1" value="&lt;b&gt;[BF-04-A1] Blank, zero or newly found stock&lt;/b&gt;&lt;br&gt;Uncounted lines cannot close session. Verified newly found items add a &lt;b&gt;found_after_cutoff&lt;/b&gt; row with &lt;b&gt;book = 0&lt;/b&gt; (original snapshot stays immutable)." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-wh">
          <mxGeometry as="geometry" x="415" y="342" width="295" height="90" />
        </mxCell>

        <!-- Row 4: Compare counts to snapshot decision -->
        <mxCell id="bf04-d1" value="&lt;b&gt;Compare valid counts&lt;br&gt;to snapshot: variance?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;UC-88&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-wh">
          <mxGeometry as="geometry" x="95" y="478" width="230" height="96" />
        </mxCell>

        <!-- Row 5: Recount & separate quality vs quantity variance -->
        <mxCell id="bf04-s5" value="&lt;b&gt;5. Recount discrepancies &amp;amp; investigate reasons&lt;/b&gt;&lt;br&gt;Check lot/units/documents; if recount matches snapshot, close without ADJ0&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Recount / Reconciliation • UC-88 [BF-04-A2, A3]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-wh">
          <mxGeometry as="geometry" x="45" y="622" width="330" height="92" />
        </mxCell>
        <mxCell id="bf04-a2" value="&lt;b&gt;[BF-04-A2] Quality variance vs missing quantity&lt;/b&gt;&lt;br&gt;Physically present damaged stock is reclassified to quarantine / &lt;b&gt;BF-02&lt;/b&gt; (total unchanged), not posted as a negative quantity loss." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-wh">
          <mxGeometry as="geometry" x="415" y="622" width="295" height="92" />
        </mxCell>

        <!-- Row 6: Propose adjustment & Owner review -->
        <mxCell id="bf04-s6" value="&lt;b&gt;6. Propose inventory adjustment delta&lt;/b&gt;&lt;br&gt;Submit verified delta &amp;amp; reason against exact snapshot/count version (never overwrite balance)&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;ADJ request • UC-91 [BR-23]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-wh">
          <mxGeometry as="geometry" x="45" y="762" width="330" height="92" />
        </mxCell>
        <mxCell id="bf04-s7" value="&lt;b&gt;7. Review adjustment proposal version&lt;/b&gt;&lt;br&gt;Approve, return for recount/evidence, or reject (requester ≠ approver; approval alone does not post)&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Approval • UC-92 [BR-05, BR-23]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-owner">
          <mxGeometry as="geometry" x="70" y="762" width="320" height="92" />
        </mxCell>

        <!-- Row 7: Owner decision diamond -->
        <mxCell id="bf04-d2" value="&lt;b&gt;Adjustment&lt;br&gt;approved?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;[BF-04-A3]&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-owner">
          <mxGeometry as="geometry" x="125" y="902" width="210" height="92" />
        </mxCell>

        <!-- Row 8: Owner Clear Difference (UC-93) + Interrupted clearing note -->
        <mxCell id="bf04-s8" value="&lt;b&gt;8. Clear Difference &amp;amp; post approved delta once&lt;/b&gt;&lt;br&gt;Atomically post increase/decrease adjustment &amp;amp; audit log with idempotent operation key&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;ADJ (POSTED) • UC-93 [BR-06, BR-23]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-owner">
          <mxGeometry as="geometry" x="70" y="1044" width="320" height="94" />
        </mxCell>
        <mxCell id="bf04-e2" value="&lt;b&gt;[BF-04-E2] Interrupted clearing recovery&lt;/b&gt;&lt;br&gt;Retain scope freeze; check committed batch by operation key before retry; never auto-unlock or double-post delta." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-wh">
          <mxGeometry as="geometry" x="415" y="1044" width="295" height="94" />
        </mxCell>

        <!-- Row 9: Close session & unlock scope -->
        <mxCell id="bf04-s9" value="&lt;b&gt;9. Complete stocktake &amp;amp; release scope freeze&lt;/b&gt;&lt;br&gt;Unlock counted locations only after all variances are resolved (or no variance found)&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;ST CLOSED (Unlocked) • UC-88, UC-93 [BF-04-A3]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf04-lane-wh">
          <mxGeometry as="geometry" x="45" y="1200" width="330" height="92" />
        </mxCell>

        <!-- Edges for BF-04 -->
        <mxCell id="bf04-e-1-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf04-s1" target="bf04-s2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf04-e-2-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf04-s2" target="bf04-s3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf04-e-3-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf04-s3" target="bf04-s4">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf04-e-4-a1" value="Blank / Found item" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf04-s4" target="bf04-a1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf04-e-4-d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf04-s4" target="bf04-d1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf04-e-d1-5" value="Variance" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;fontSize=12;fontColor=#17304d;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf04-d1" target="bf04-s5">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf04-e-d1-9" value="No variance (skip ADJ0) [BF-04-A3]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=12;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf04-d1" target="bf04-s9">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1225" y="636" />
              <mxPoint x="1225" y="1356" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf04-e-5-a2" value="Damaged present" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf04-s5" target="bf04-a2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf04-e-5-6" value="Verified quantity delta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;fontSize=11;fontColor=#17304d;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf04-s5" target="bf04-s6">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf04-e-6-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf04-s6" target="bf04-s7">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf04-e-7-d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf04-s7" target="bf04-d2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf04-e-d2-5" value="Return / Recount" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=12;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf04-d2" target="bf04-s5">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="520" y="1058" />
              <mxPoint x="520" y="778" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf04-e-d2-8" value="Approve exact version" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=12;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf04-d2" target="bf04-s8">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf04-e-8-e2" value="If interrupted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf04-s8" target="bf04-e2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf04-e-8-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf04-s8" target="bf04-s9">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="270" y="1356" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="bf04-legend" value="Blue: action / document • Green: snapshot freeze, Clear Difference delta posting or unlock • Yellow diamond: decision branch • Red: exception / alternate outcome" style="text;align=left;fontSize=13;fontStyle=1;fontColor=#43566f;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1575" width="1200" height="28" />
        </mxCell>
        <mxCell id="bf04-note" value="&lt;b&gt;Document &amp;amp; Posting Semantics (BF-04):&lt;/b&gt; D5 selects scope locking (&lt;b&gt;ST FROZEN&lt;/b&gt;) with an immutable cutoff &lt;b&gt;Snapshot&lt;/b&gt; and exported &lt;b&gt;COUNT sheet&lt;/b&gt; (UC-105); concurrent-movement counting is not used. Blank lines mean uncounted (never zero). Physically present damaged tiles are reclassified to quarantine (&lt;b&gt;BF-02&lt;/b&gt;), not deducted as missing quantity. If no variance exists, the session closes and unlocks without a zero adjustment (&lt;b&gt;no ADJ0&lt;/b&gt;). Warehouse Staff proposes the delta (UC-91); Store Owner approves the exact version (UC-92) and separately executes &lt;b&gt;Clear Difference (UC-93)&lt;/b&gt; to post the delta once." style="rounded=1;fillColor=#f3f5f8;strokeColor=#d6dde6;align=left;spacing=12;fontSize=13;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1610" width="1200" height="150" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="BF-05" name="BF-05">
    <mxGraphModel dx="1440" dy="1880" grid="1" gridSize="10" page="1" pageWidth="1440" pageHeight="1880" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bf05-title" value="BF-05 — Issue request, picking and handover" style="text;align=left;fontSize=24;fontStyle=1;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1360" height="42" />
        </mxCell>
        <mxCell id="bf05-subtitle" value="To-be D1–D8 • Updated 21 Oct 2026 • Authoritative specification: docs/02_nghiep_vu/de_xuat_quy_trinh_2_EN.md (Sections 4, 15, 16)" style="text;align=left;fontSize=13;fontColor=#58677c;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="64" width="1360" height="28" />
        </mxCell>
        <mxCell id="bf05-lane-sales" value="Sales Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="110" width="380" height="1510" />
        </mxCell>
        <mxCell id="bf05-lane-wh" value="Warehouse Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420" y="110" width="620" height="1510" />
        </mxCell>
        <mxCell id="bf05-lane-acc" value="Accountant" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="110" width="360" height="1510" />
        </mxCell>

        <!-- Row 1: Enter verified WIR & Check availability -->
        <mxCell id="bf05-s1" value="&lt;b&gt;1. Enter verified Warehouse Issue Request (WIR)&lt;/b&gt;&lt;br&gt;Normalize external order/paper/Zalo/phone demand; deduplicate by source + line + release&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;WIR • UC-45–48 [BF-05-E1, BR-28]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-sales">
          <mxGeometry as="geometry" x="30" y="66" width="320" height="92" />
        </mxCell>

        <!-- Row 2: Availability & compatibility check decision + A1 shortage/substitution -->
        <mxCell id="bf05-d1" value="&lt;b&gt;Compatible available&lt;br&gt;stock sufficient?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;UC-103&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-sales">
          <mxGeometry as="geometry" x="80" y="204" width="220" height="96" />
        </mxCell>
        <mxCell id="bf05-a1" value="&lt;b&gt;[BF-05-A1] Shortage, partial delivery or lot/tone change&lt;/b&gt;&lt;br&gt;Suggest &lt;b&gt;BF-03&lt;/b&gt; (direct dispatch/transfer) or &lt;b&gt;BF-01&lt;/b&gt; (replenishment). Obtain customer consent for partial release, waiting or lot/tone substitution (never substitute solely on SKU)." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-wh">
          <mxGeometry as="geometry" x="40" y="200" width="330" height="104" />
        </mxCell>

        <!-- Row 3: Confirm OD release & Reserve stock -->
        <mxCell id="bf05-s2" value="&lt;b&gt;2. Confirm Outbound Delivery (OD) release&lt;/b&gt;&lt;br&gt;One warehouse per release; split across warehouses if agreed&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;OD • UC-49–51 [BF-05-A1]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-sales">
          <mxGeometry as="geometry" x="30" y="348" width="320" height="88" />
        </mxCell>
        <mxCell id="bf05-s3" value="&lt;b&gt;3. Atomically reserve stock &amp;amp; assign picking task&lt;/b&gt;&lt;br&gt;Compatibility precedes FIFO; reservation reduces availability, not warehouse total&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;Reservation / TO-PICK • UC-51, UC-54 [BF-05-E1, BR-13, BR-14]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-wh">
          <mxGeometry as="geometry" x="40" y="348" width="330" height="88" />
        </mxCell>

        <!-- Row 4: Pick & confirm into staging -->
        <mxCell id="bf05-s4" value="&lt;b&gt;4. Pick, count BOX/PIECE &amp;amp; confirm into staging&lt;/b&gt;&lt;br&gt;Record partial cartons/loose pieces; moves bin → staging (warehouse total unchanged)&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;TO-PICK (CONFIRMED) • UC-55 [BR-14, BR-30]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-wh">
          <mxGeometry as="geometry" x="40" y="484" width="330" height="90" />
        </mxCell>

        <!-- Row 5: Picking discrepancy check & E2 handling -->
        <mxCell id="bf05-d2" value="&lt;b&gt;Shortage or damage&lt;br&gt;found in picking?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;[BF-05-E2]&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-wh">
          <mxGeometry as="geometry" x="95" y="618" width="220" height="92" />
        </mxCell>
        <mxCell id="bf05-e2" value="&lt;b&gt;[BF-05-E2] Picking discrepancy handling&lt;/b&gt;&lt;br&gt;Isolate defects → &lt;b&gt;BF-02&lt;/b&gt;; unexplained book/physical mismatch → targeted &lt;b&gt;BF-04&lt;/b&gt; (never overwrite balance). Notify Sales to reallocate." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-wh">
          <mxGeometry as="geometry" x="355" y="616" width="240" height="96" />
        </mxCell>

        <!-- Row 6: Draft GI & Handover completion check -->
        <mxCell id="bf05-s5" value="&lt;b&gt;5. Final check &amp;amp; draft Goods Issue from counted quantity&lt;/b&gt;&lt;br&gt;Prepare handover record; printing/drafting does not deduct stock&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;GI-S draft • UC-56–57&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-wh">
          <mxGeometry as="geometry" x="40" y="756" width="330" height="88" />
        </mxCell>

        <!-- Row 7: Handover decision & A2 Failed/Delayed handover -->
        <mxCell id="bf05-d3" value="&lt;b&gt;Actual handover&lt;br&gt;completed?&lt;/b&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-wh">
          <mxGeometry as="geometry" x="95" y="888" width="220" height="90" />
        </mxCell>
        <mxCell id="bf05-a2" value="&lt;b&gt;[BF-05-A2] Cancelled / delayed before PGI&lt;/b&gt;&lt;br&gt;Keep staged or post traceable &lt;b&gt;TO-UNPICK&lt;/b&gt; to storage; release reservation before cancelling unissued remainder. No PGI, total unchanged." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-wh">
          <mxGeometry as="geometry" x="355" y="884" width="240" height="98" />
        </mxCell>

        <!-- Row 8: PGI (Inventory Posting) + Post-PGI note -->
        <mxCell id="bf05-s6" value="&lt;b&gt;6. Physically hand over &amp;amp; Post Goods Issue (PGI) once&lt;/b&gt;&lt;br&gt;Record recipient/carrier, time &amp;amp; evidence; deducts dispatched quantity once &amp;amp; consumes reservation&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;GI-S (POSTED) + HO • UC-58 [D1, BR-06, BR-14, BR-26]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-wh">
          <mxGeometry as="geometry" x="40" y="1026" width="330" height="96" />
        </mxCell>
        <mxCell id="bf05-e3" value="&lt;b&gt;[BF-05-E3] After PGI&lt;/b&gt;&lt;br&gt;Carrier handover ≠ customer receipt. Never restore stock via status edit; physical returns use &lt;b&gt;BF-06&lt;/b&gt;; posting errors use linked &lt;b&gt;REV&lt;/b&gt;." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-wh">
          <mxGeometry as="geometry" x="395" y="1026" width="200" height="96" />
        </mxCell>

        <!-- Row 9: Track fulfilment & Reconcile external documents -->
        <mxCell id="bf05-s7" value="&lt;b&gt;7. Update issued/outstanding quantities &amp;amp; close WIR/OD&lt;/b&gt;&lt;br&gt;Close on full issue or authorized cancellation of unexecuted remainder&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;WIR / OD COMPLETED • UC-48, UC-51&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-sales">
          <mxGeometry as="geometry" x="30" y="1174" width="320" height="92" />
        </mxCell>
        <mxCell id="bf05-s8" value="&lt;b&gt;8. Reconcile warehouse issue with external MISA records&lt;/b&gt;&lt;br&gt;Record external invoice/order reference; explain ordered-but-undelivered stock (D1)&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;External references • UC-108 [UC-59–62 retired]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf05-lane-acc">
          <mxGeometry as="geometry" x="30" y="1320" width="300" height="92" />
        </mxCell>

        <!-- Edges for BF-05 -->
        <mxCell id="bf05-e-1-d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf05-s1" target="bf05-d1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf05-e-d1-a1" value="Shortage / Substitute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf05-d1" target="bf05-a1">
