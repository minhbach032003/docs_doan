        </mxCell>
        <mxCell id="bf01-e-d3-8" value="No / Cancel remainder" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;fontSize=12;fontColor=#17304d;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf01-d3" target="bf01-s8">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf01-e-d3-4" value="Yes (next delivery / linked replacement GR)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#667a92;strokeWidth=1.5;fontSize=12;fontColor=#43566f;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf01-d3" target="bf01-s4">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1500" y="1488" />
              <mxPoint x="1500" y="770" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="bf01-legend" value="Blue: action / document • Green: inventory, custody or task-confirmation posting • Yellow diamond: decision branch • Red: exception / alternate outcome" style="text;align=left;fontSize=13;fontStyle=1;fontColor=#43566f;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1635" width="1480" height="28" />
        </mxCell>
        <mxCell id="bf01-note" value="&lt;b&gt;Document &amp;amp; Posting Semantics (BF-01):&lt;/b&gt; RR, Owner approval and PO do not increase stock. Only &lt;b&gt;GR-P&lt;/b&gt; increases store-owned stock once at actual quality/location; &lt;b&gt;TO-PUTAWAY&lt;/b&gt; relocates stock to storage bins and enables allocation without increasing total stock a second time. Unaccepted goods held at the store are recorded in &lt;b&gt;CUS-IN&lt;/b&gt; (supplier custody, excluded from store-owned/available stock); immediately rejected goods are handed back without fictitious receipt/issue. Owned defective goods enter &lt;b&gt;BF-02&lt;/b&gt;; returning previously received goods uses &lt;b&gt;BF-07&lt;/b&gt;. Replacements are new linked arrivals/GR-Ps (never overwrite posted GR-Ps). No automatic MISA API sync." style="rounded=1;fillColor=#f3f5f8;strokeColor=#d6dde6;align=left;spacing=12;fontSize=13;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1670" width="1480" height="150" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="BF-02" name="BF-02">
    <mxGraphModel dx="1280" dy="1680" grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="1680" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bf02-title" value="BF-02 — Defect detection, isolation and disposition" style="text;align=left;fontSize=24;fontStyle=1;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1200" height="42" />
        </mxCell>
        <mxCell id="bf02-subtitle" value="To-be D1–D8 • Updated 21 Oct 2026 • Authoritative specification: docs/02_nghiep_vu/de_xuat_quy_trinh_2_EN.md (Sections 4, 15, 16)" style="text;align=left;fontSize=13;fontColor=#58677c;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="64" width="1200" height="28" />
        </mxCell>
        <mxCell id="bf02-lane-wh" value="Warehouse Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="110" width="760" height="1310" />
        </mxCell>
        <mxCell id="bf02-lane-owner" value="Store Owner" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="110" width="440" height="1310" />
        </mxCell>

        <!-- Row 1: Detect & record defect -->
        <mxCell id="bf02-s1" value="&lt;b&gt;1. Record defect case, source, lot, location &amp;amp; evidence&lt;/b&gt;&lt;br&gt;Triggered from BF-01/03/04/05/06 or routine work; attach photos/symptoms&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;DC • UC-63–65&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-wh">
          <mxGeometry as="geometry" x="40" y="66" width="320" height="90" />
        </mxCell>

        <!-- Row 2: Immediate quarantine & block + E1 reserved/picked note -->
        <mxCell id="bf02-s2" value="&lt;b&gt;2. Immediately block allocation &amp;amp; quarantine&lt;/b&gt;&lt;br&gt;Do NOT wait for Owner approval to block defective stock&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;TO-QUARANTINE • UC-65 [BR-19]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-wh">
          <mxGeometry as="geometry" x="40" y="200" width="320" height="90" />
        </mxCell>
        <mxCell id="bf02-e1" value="&lt;b&gt;[BF-02-E1] Defect in reserved / picked stock&lt;/b&gt;&lt;br&gt;Immediately block defective quantity, preserve demand linkage, notify Sales &amp;amp; seek replacement supply (UC-103) without waiting for disposition approval." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-wh">
          <mxGeometry as="geometry" x="410" y="200" width="315" height="90" />
        </mxCell>

        <!-- Row 3: Verify condition & ownership/custody + A1 unclear ownership -->
        <mxCell id="bf02-s3" value="&lt;b&gt;3. Verify condition &amp;amp; ownership vs custody&lt;/b&gt;&lt;br&gt;Quarantine never transfers ownership; MISA discount does not make defective stock GOOD&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;INS • UC-65 [BF-02-A1]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-wh">
          <mxGeometry as="geometry" x="40" y="336" width="320" height="90" />
        </mxCell>
        <mxCell id="bf02-a1" value="&lt;b&gt;[BF-02-A1 / A2] Unclear ownership or rejected proposal&lt;/b&gt;&lt;br&gt;Keep PENDING/BLOCKED in quarantine with recorded owner; never turn custody into store stock. Supplement evidence &amp;amp; resubmit." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-wh">
          <mxGeometry as="geometry" x="410" y="336" width="315" height="90" />
        </mxCell>

        <!-- Row 4: Propose disposition & Owner review -->
        <mxCell id="bf02-s4" value="&lt;b&gt;4. Propose per-quantity disposition&lt;/b&gt;&lt;br&gt;Release after reinspection, conditional regrade, supplier return, or destruction&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;DISP proposal • UC-65&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-wh">
          <mxGeometry as="geometry" x="40" y="472" width="320" height="90" />
        </mxCell>
        <mxCell id="bf02-s5" value="&lt;b&gt;5. Review &amp;amp; decide disposition per quantity/version&lt;/b&gt;&lt;br&gt;Approve exact action &amp;amp; quantity or request more evidence (requester ≠ approver)&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Approval • UC-66 [BR-05, EX-01]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-owner">
          <mxGeometry as="geometry" x="60" y="472" width="320" height="90" />
        </mxCell>

        <!-- Row 5: Owner approval decision diamond -->
        <mxCell id="bf02-d1" value="&lt;b&gt;Disposition&lt;br&gt;approved?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;[BF-02-A2]&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-owner">
          <mxGeometry as="geometry" x="115" y="612" width="210" height="92" />
        </mxCell>
        <mxCell id="bf02-d2" value="&lt;b&gt;Approved outcome&lt;br&gt;per quantity&lt;/b&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-wh">
          <mxGeometry as="geometry" x="95" y="612" width="210" height="92" />
        </mxCell>

        <!-- Row 6 & 7: Three distinct execution outcomes in Warehouse lane -->
        <mxCell id="bf02-s6a" value="&lt;b&gt;6a. Release / Conditional Regrade&lt;/b&gt;&lt;br&gt;Record before/after quality &amp;amp; move to eligible bin; store-owned total unchanged&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;Quality / Location update • UC-67&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-wh">
          <mxGeometry as="geometry" x="40" y="764" width="320" height="92" />
        </mxCell>
        <mxCell id="bf02-s6b" value="&lt;b&gt;6b. Route to Supplier Return (BF-07)&lt;/b&gt;&lt;br&gt;Link valid Owner decision to &lt;b&gt;BF-07&lt;/b&gt;; NO stock deduction in BF-02 (deducts at GI-SR in BF-07)&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;SR link → BF-07 • UC-67, UC-82 [BF-02-E2]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-wh">
          <mxGeometry as="geometry" x="410" y="764" width="315" height="92" />
        </mxCell>
        <mxCell id="bf02-s6c" value="&lt;b&gt;6c. Execute Physical Destruction &amp;amp; Post Scrap&lt;/b&gt;&lt;br&gt;Requires actual destruction evidence &amp;amp; quantity (approval alone does not deduct); posts once&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;SCRAP (POSTED) • UC-67 [BF-02-E2, BR-19]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-wh">
          <mxGeometry as="geometry" x="40" y="904" width="320" height="92" />
        </mxCell>

        <!-- Row 8: Reconcile & Close DC -->
        <mxCell id="bf02-s7" value="&lt;b&gt;7. Reconcile quantities &amp;amp; close Defect Case&lt;/b&gt;&lt;br&gt;Close only when every quantity is resolved or linked to an accountable open BF-07 case&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;DC CLOSED / Linked SR • UC-67&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf02-lane-wh">
          <mxGeometry as="geometry" x="40" y="1052" width="320" height="92" />
        </mxCell>

        <!-- Edges for BF-02 -->
        <mxCell id="bf02-e-1-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf02-s1" target="bf02-s2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf02-e-2-e1" value="If reserved/picked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf02-s2" target="bf02-e1">
          <mxGeometry as="geometry" relative="1" />
