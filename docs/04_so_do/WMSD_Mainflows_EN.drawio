  <diagram id="BF-01" name="BF-01">
    <mxGraphModel dx="1560" dy="1880" grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="1880" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bf01-title" value="BF-01 — Replenishment, purchasing and goods receipt" style="text;align=left;fontSize=24;fontStyle=1;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1480" height="42" />
        </mxCell>
        <mxCell id="bf01-subtitle" value="To-be D1–D8 • Updated 21 Oct 2026 • Authoritative specification: docs/02_nghiep_vu/de_xuat_quy_trinh_2_EN.md (Sections 4, 15, 16)" style="text;align=left;fontSize=13;fontColor=#58677c;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="64" width="1480" height="28" />
        </mxCell>
        <mxCell id="bf01-lane-sales" value="Sales Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="110" width="350" height="1510" />
        </mxCell>
        <mxCell id="bf01-lane-owner" value="Store Owner" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390" y="110" width="370" height="1510" />
        </mxCell>
        <mxCell id="bf01-lane-acc" value="Accountant" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="760" y="110" width="370" height="1510" />
        </mxCell>
        <mxCell id="bf01-lane-wh" value="Warehouse Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1130" y="110" width="390" height="1510" />
        </mxCell>

        <!-- Row 1: Originating demand -->
        <mxCell id="bf01-s1a" value="&lt;b&gt;1a. Record customer shortage demand&lt;/b&gt;&lt;br&gt;Check available/reserved stock, open POs &amp;amp; transfers; submit uncovered balance&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;RR • UC-03, UC-103 [BF-01-A1]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-sales">
          <mxGeometry as="geometry" x="25" y="66" width="300" height="92" />
        </mxCell>
        <mxCell id="bf01-s1b" value="&lt;b&gt;1b. Record reserve-stock need&lt;/b&gt;&lt;br&gt;From fixed minimum-stock alert, stocktake or defect outcome; check existing supply&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;RR • UC-03, UC-103 [BF-01-A1]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-wh">
          <mxGeometry as="geometry" x="45" y="66" width="300" height="92" />
        </mxCell>

        <!-- Row 2: Owner review & decision -->
        <mxCell id="bf01-s2" value="&lt;b&gt;2. Review Replenishment Request (RR)&lt;/b&gt;&lt;br&gt;Verify uncovered need &amp;amp; quantities; requester ≠ approver&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;RR Review • UC-04 [BR-05, EX-01]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-owner">
          <mxGeometry as="geometry" x="35" y="206" width="300" height="86" />
        </mxCell>

        <!-- Row 3: Owner decision diamond + Reject/Revise outcome -->
        <mxCell id="bf01-d1" value="&lt;b&gt;RR approved?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;UC-04&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-owner">
          <mxGeometry as="geometry" x="85" y="336" width="200" height="88" />
        </mxCell>
        <mxCell id="bf01-a2" value="&lt;b&gt;[BF-01-A2] Reject or request revision&lt;/b&gt;&lt;br&gt;Record reason; reject closes RR (no stock change); revision creates new RR version. No PO before approval." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-sales">
          <mxGeometry as="geometry" x="25" y="336" width="300" height="88" />
        </mxCell>

        <!-- Row 4: Accountant creates PO -->
        <mxCell id="bf01-s3" value="&lt;b&gt;3. Create PO &amp;amp; record supplier confirmation&lt;/b&gt;&lt;br&gt;Record confirmed quantities &amp;amp; schedule; changes beyond approval require re-approval&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;PO • UC-05–07 [BF-01-A3]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-acc">
          <mxGeometry as="geometry" x="35" y="472" width="300" height="92" />
        </mxCell>

        <!-- Row 5: Warehouse arrival & inspection -->
        <mxCell id="bf01-s4" value="&lt;b&gt;4. Receive delivery &amp;amp; inspect per line&lt;/b&gt;&lt;br&gt;Check BOX/PIECE, lot, tone, calibre, cracks &amp;amp; packaging; record co-inspectors; count pieces in open/torn boxes&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;ARR / INS • UC-10, UC-26 [BF-01-A4]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-wh">
          <mxGeometry as="geometry" x="45" y="612" width="300" height="96" />
        </mxCell>

        <!-- Row 6: Classification decision & Discrepancy handling -->
        <mxCell id="bf01-d2" value="&lt;b&gt;Classify each&lt;br&gt;delivered quantity&lt;/b&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-wh">
          <mxGeometry as="geometry" x="95" y="756" width="200" height="92" />
        </mxCell>
        <mxCell id="bf01-e1" value="&lt;b&gt;[BF-01-E1 / E2] Over, wrong lot/tone, or 0 accepted&lt;/b&gt;&lt;br&gt;Segregate pending/custody (&lt;b&gt;CUS-IN&lt;/b&gt;) or hand back immediately; record &lt;b&gt;VAR&lt;/b&gt;. No auto-substitution on SKU; no zero-quantity GR; Accountant/Owner coordinate changes." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-acc">
          <mxGeometry as="geometry" x="35" y="752" width="300" height="100" />
        </mxCell>

        <!-- Row 7: Post GR-P (Inventory Posting) + BF-02 route -->
        <mxCell id="bf01-s5" value="&lt;b&gt;5. Post Goods Receipt for accepted quantities&lt;/b&gt;&lt;br&gt;Increases store-owned stock once at actual quality/location; owned defects route to &lt;b&gt;BF-02&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;GR-P (POSTED) / CUS-IN • UC-26 [BR-06, BR-07]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-wh">
          <mxGeometry as="geometry" x="45" y="896" width="300" height="96" />
        </mxCell>

        <!-- Row 8: Put-away TO -->
        <mxCell id="bf01-s6" value="&lt;b&gt;6. Suggest storage &amp;amp; confirm put-away&lt;/b&gt;&lt;br&gt;Move from receiving to storage bins; enables allocation when GOOD &amp;amp; placed (no 2nd stock increase)&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;TO-PUTAWAY (CONFIRMED) • UC-32–33&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-wh">
          <mxGeometry as="geometry" x="45" y="1040" width="300" height="96" />
        </mxCell>

        <!-- Row 9: Reconcile PO & GR -->
        <mxCell id="bf01-s7" value="&lt;b&gt;7. Update cumulative PO &amp;amp; reconcile documents&lt;/b&gt;&lt;br&gt;Reconcile PO, GR-P &amp;amp; supplier documents; record MISA reference (warehouse work need not wait)&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;PO ↔ GR-P / External ref • UC-07, UC-108&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-acc">
          <mxGeometry as="geometry" x="35" y="1184" width="300" height="96" />
        </mxCell>

        <!-- Row 10: Further delivery decision & Short-closure approval -->
        <mxCell id="bf01-d3" value="&lt;b&gt;Further delivery&lt;br&gt;or replacement?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;[BF-01-A3, A4]&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-acc">
          <mxGeometry as="geometry" x="85" y="1330" width="200" height="96" />
        </mxCell>
        <mxCell id="bf01-s8" value="&lt;b&gt;8. Authorize short closure / complete PO&lt;/b&gt;&lt;br&gt;Owner approves cancellation of undelivered remainder; preserve posted GR-Ps, no fictitious receipt&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;PO COMPLETED • UC-04, UC-07 [BF-01-A3]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf01-lane-owner">
          <mxGeometry as="geometry" x="35" y="1330" width="300" height="96" />
        </mxCell>

        <!-- Edges for BF-01 -->
