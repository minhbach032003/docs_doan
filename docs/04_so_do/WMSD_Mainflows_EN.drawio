        </mxCell>
        <mxCell id="bf05-e-2-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf05-s2" target="bf05-s3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf05-e-3-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf05-s3" target="bf05-s4">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf05-e-4-d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf05-s4" target="bf05-d2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf05-e-d2-e2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=12;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf05-d2" target="bf05-e2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf05-e-e2-a1" value="Replan supply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf05-e2" target="bf05-a1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="895" y="362" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf05-e-d2-5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=12;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf05-d2" target="bf05-s5">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf05-e-5-d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf05-s5" target="bf05-d3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf05-e-d3-a2" value="No (Delayed / Cancelled)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf05-d3" target="bf05-a2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf05-e-d3-6" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=12;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf05-d3" target="bf05-s6">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf05-e-6-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85c5c;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf05-s6" target="bf05-e3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf05-e-6-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf05-s6" target="bf05-s7">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="625" y="1256" />
              <mxPoint x="230" y="1256" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf05-e-7-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf05-s7" target="bf05-s8">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="230" y="1402" />
              <mxPoint x="1220" y="1402" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="bf05-legend" value="Blue: action / document • Green: reservation, picking confirmation or PGI posting • Yellow diamond: decision branch • Red: exception / alternate outcome" style="text;align=left;fontSize=13;fontStyle=1;fontColor=#43566f;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1635" width="1360" height="28" />
        </mxCell>
        <mxCell id="bf05-note" value="&lt;b&gt;Document &amp;amp; Posting Semantics (BF-05):&lt;/b&gt; WMSD replaces internal Sales Orders and internal invoices (UC-59–62 retired) with externally referenced &lt;b&gt;WIR / OD&lt;/b&gt;. Reservation reduces available stock only; &lt;b&gt;TO-PICK&lt;/b&gt; moves stock from storage bins to staging without reducing warehouse on-hand total; &lt;b&gt;PGI (GI-S)&lt;/b&gt; deducts the physically handed-over quantity exactly once and consumes the matching reservation (D1). Carrier handover is not proof of customer receipt (BR-26). Failed handover before PGI keeps goods staged or uses traceable &lt;b&gt;TO-UNPICK&lt;/b&gt;; post-PGI returns use &lt;b&gt;BF-06&lt;/b&gt;." style="rounded=1;fillColor=#f3f5f8;strokeColor=#d6dde6;align=left;spacing=12;fontSize=13;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1670" width="1360" height="150" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="BF-06" name="BF-06">
    <mxGraphModel dx="1600" dy="1940" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1940" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bf06-title" value="BF-06 — Customer return and classification for receipt" style="text;align=left;fontSize=24;fontStyle=1;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1520" height="42" />
        </mxCell>
        <mxCell id="bf06-subtitle" value="To-be D1–D8 • Updated 21 Oct 2026 • Authoritative specification: docs/02_nghiep_vu/de_xuat_quy_trinh_2_EN.md (Sections 4, 15, 16)" style="text;align=left;fontSize=13;fontColor=#58677c;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="64" width="1520" height="28" />
        </mxCell>
        <mxCell id="bf06-lane-sales" value="Sales Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="110" width="350" height="1560" />
        </mxCell>
        <mxCell id="bf06-lane-wh" value="Warehouse Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390" y="110" width="460" height="1560" />
        </mxCell>
        <mxCell id="bf06-lane-owner" value="Store Owner" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="110" width="350" height="1560" />
        </mxCell>
        <mxCell id="bf06-lane-acc" value="Accountant" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="110" width="360" height="1560" />
        </mxCell>

        <!-- Row 1: Register CR & Historical sale verification -->
        <mxCell id="bf06-s1" value="&lt;b&gt;1. Register Customer Return (CR) &amp;amp; check commercial terms&lt;/b&gt;&lt;br&gt;Validate source GI/order, cumulative returnable balance &amp;amp; D6 terms (no invented return days)&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;CR • UC-70 [BR-16, BR-17, BR-29]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-sales">
          <mxGeometry as="geometry" x="25" y="66" width="300" height="96" />
        </mxCell>
        <mxCell id="bf06-a1" value="&lt;b&gt;[BF-06-A1] Pre-WMS historical sale&lt;/b&gt;&lt;br&gt;Accountant verifies external dispatched &amp;amp; returned history (UC-108); never fabricate a historical GI." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-acc">
          <mxGeometry as="geometry" x="30" y="66" width="300" height="96" />
        </mxCell>

        <!-- Row 2: Pre-intake check decision & Customer Custody intake -->
        <mxCell id="bf06-d1" value="&lt;b&gt;Eligible for intake&lt;br&gt;or pending check?&lt;/b&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-sales">
          <mxGeometry as="geometry" x="70" y="208" width="210" height="92" />
        </mxCell>
        <mxCell id="bf06-s2" value="&lt;b&gt;2. Receive returned goods into customer custody&lt;/b&gt;&lt;br&gt;Records physical responsibility only; does NOT increase store-owned/sellable stock or confirm refund&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;CUS-IN (Custody) • UC-72 [BR-07, BR-26]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-wh">
          <mxGeometry as="geometry" x="65" y="206" width="330" height="96" />
        </mxCell>

        <!-- Row 3: Pre-intake rejection vs Physical inspection per line -->
        <mxCell id="bf06-a3pre" value="&lt;b&gt;[BF-06-E1 / A3] Rejected or withdrawn before intake&lt;/b&gt;&lt;br&gt;Close CR with reason when proven ineligible or withdrawn before intake; no custody or stock posting." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-sales">
          <mxGeometry as="geometry" x="25" y="348" width="300" height="92" />
        </mxCell>
        <mxCell id="bf06-s3" value="&lt;b&gt;3. Inspect &amp;amp; split per quantity/line; record D6 evidence&lt;/b&gt;&lt;br&gt;Count BOX/PIECE, check lot/tone/calibre, packaging, installation/use, damage cause &amp;amp; deadline evidence&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;INS (Versioned assessment) • UC-72 [BF-06-A2, BR-29, BR-30]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-wh">
          <mxGeometry as="geometry" x="65" y="346" width="330" height="96" />
        </mxCell>

        <!-- Row 4: D6 Verification status decision & Pending custody note -->
        <mxCell id="bf06-d2" value="&lt;b&gt;D6 conditions &amp;amp;&lt;br&gt;source verified?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;[BF-06-E1]&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-wh">
          <mxGeometry as="geometry" x="115" y="488" width="230" height="92" />
        </mxCell>
        <mxCell id="bf06-e1" value="&lt;b&gt;[BF-06-E1 / E2] Unknown deadline/terms or changed assessment&lt;/b&gt;&lt;br&gt;Unverified deadline stays &lt;b&gt;PENDING&lt;/b&gt; in custody (no GR-CR, no invented days). Changed assessment requires a new version &amp;amp; re-approval." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-sales">
          <mxGeometry as="geometry" x="25" y="486" width="300" height="96" />
        </mxCell>

        <!-- Row 5: Store Owner decides acceptance AFTER inspection -->
        <mxCell id="bf06-s4" value="&lt;b&gt;4. Decide acceptance per line AFTER inspection&lt;/b&gt;&lt;br&gt;Sealed/unused loose tiles case-by-case; reject installed, customer-damaged or confirmed overdue lines&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Owner Acceptance • UC-71 [D6, BF-06-A2, BR-17, BR-29]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-owner">
          <mxGeometry as="geometry" x="25" y="486" width="300" height="96" />
        </mxCell>
        <mxCell id="bf06-d3" value="&lt;b&gt;Per-quantity&lt;br&gt;Owner decision&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;[BF-06-A2]&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-owner">
          <mxGeometry as="geometry" x="70" y="630" width="210" height="92" />
        </mxCell>

        <!-- Rows 6, 7, 8: Three distinct per-quantity warehouse outcomes -->
        <mxCell id="bf06-s5a" value="&lt;b&gt;5a. Accepted GOOD: Post GR-CR &amp;amp; confirm put-away&lt;/b&gt;&lt;br&gt;Transfers accepted good quantity from custody to store-owned stock; available after put-away&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;GR-CR (GOOD) + TO-PUTAWAY • UC-33, UC-73 [BR-18]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-wh">
          <mxGeometry as="geometry" x="65" y="630" width="330" height="92" />
        </mxCell>
        <mxCell id="bf06-s5b" value="&lt;b&gt;5b. Accepted supplier-defective: Post quarantine GR-CR&lt;/b&gt;&lt;br&gt;Store assumes responsibility into store-owned quarantine; link to &lt;b&gt;BF-02 / BF-07&lt;/b&gt; (unavailable for sale)&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;GR-CR (Quarantine) + DC • UC-73 [BF-06-A2, BR-18]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-wh">
          <mxGeometry as="geometry" x="65" y="766" width="330" height="92" />
        </mxCell>
        <mxCell id="bf06-s5c" value="&lt;b&gt;5c. Rejected / Ineligible: Hand back &amp;amp; release custody&lt;/b&gt;&lt;br&gt;Stays outside store-owned stock; close custody only on actual physical handback (&lt;b&gt;CUS-OUT + HO&lt;/b&gt;)&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;CUS-OUT + HO • UC-73 [BF-06-A3, BR-18]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-wh">
          <mxGeometry as="geometry" x="65" y="902" width="330" height="92" />
        </mxCell>

        <!-- Row 9: Communicate outcome & Close warehouse return -->
        <mxCell id="bf06-s6" value="&lt;b&gt;6. Communicate warehouse return outcome to customer&lt;/b&gt;&lt;br&gt;Close warehouse processing when every received quantity is accepted, handed back or linked to open case&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;CR warehouse status • UC-70, UC-73&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-sales">
          <mxGeometry as="geometry" x="25" y="1050" width="300" height="96" />
        </mxCell>

        <!-- Row 10: Accountant external MISA follow-up -->
        <mxCell id="bf06-s7" value="&lt;b&gt;7. Record external invoice / refund / offset references&lt;/b&gt;&lt;br&gt;Refund/invoice handled in MISA; WMSD stores references only (no refund calculation/payment)&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;External references • UC-108 [D6, UC-74–78 retired]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf06-lane-acc">
          <mxGeometry as="geometry" x="18" y="1190" width="324" height="116" />
        </mxCell>

        <!-- Edges for BF-06 -->
        <mxCell id="bf06-e-1-a1" value="If pre-WMS sale" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf06-s1" target="bf06-a1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf06-e-1-d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf06-s1" target="bf06-d1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf06-e-d1-a3pre" value="Ineligible / Withdrawn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf06-d1" target="bf06-a3pre">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf06-e-d1-2" value="Intake for inspection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=12;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf06-d1" target="bf06-s2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf06-e-2-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf06-s2" target="bf06-s3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf06-e-3-d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf06-s3" target="bf06-d2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf06-e-d2-e1" value="Unknown / Pending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf06-d2" target="bf06-e1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf06-e-d2-4" value="Verified assessment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;fontSize=12;fontColor=#17304d;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf06-d2" target="bf06-s4">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf06-e-4-d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf06-s4" target="bf06-d3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf06-e-d3-5a" value="Accept GOOD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=11;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf06-d3" target="bf06-s5a">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf06-e-d3-5b" value="Accept supplier-defective" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=11;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf06-d3" target="bf06-s5b">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1025" y="922" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf06-e-d3-5c" value="Reject / Ineligible" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf06-d3" target="bf06-s5c">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1165" y="786" />
              <mxPoint x="1165" y="1058" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf06-e-5a-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf06-s5a" target="bf06-s6">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="420" y="786" />
              <mxPoint x="420" y="1130" />
              <mxPoint x="215" y="1130" />
            </Array>
