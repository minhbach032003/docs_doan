        <mxCell id="bf02-e-4-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf02-s4" target="bf02-s5">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf02-e-5-d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf02-s5" target="bf02-d1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf02-e-d1-a1" value="No / Unapproved part" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=12;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf02-d1" target="bf02-a1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1020" y="700" />
              <mxPoint x="830" y="700" />
              <mxPoint x="830" y="491" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf02-e-a1-3" value="Supplement / Revise" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf02-a1" target="bf02-s3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf02-e-d1-d2" value="Yes (approved portion)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=12;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf02-d1" target="bf02-d2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf02-e-d2-6a" value="Release / Regrade" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=11;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf02-d2" target="bf02-s6a">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="bf02-e-d2-6b" value="Supplier return" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;fontSize=11;fontColor=#17304d;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf02-d2" target="bf02-s6b">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="607" y="768" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf02-e-d2-6c" value="Destroy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#438463;strokeWidth=1.5;fontSize=11;fontColor=#2b5b42;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf02-d2" target="bf02-s6c">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="60" y="768" />
              <mxPoint x="60" y="1060" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf02-e-6a-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=1;entryY=0.25;" edge="1" parent="1" source="bf02-s6a" target="bf02-s7">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="425" y="920" />
              <mxPoint x="425" y="1185" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf02-e-6b-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="bf02-s6b" target="bf02-s7">
