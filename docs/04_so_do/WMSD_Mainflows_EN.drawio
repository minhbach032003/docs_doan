        </mxCell>
        <mxCell id="bf06-e-6-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="bf06-s6" target="bf06-s7">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="215" y="1358" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="bf06-legend" value="Blue: action / document • Green: custody intake/release or GR-CR posting • Yellow diamond: decision branch • Red: exception / alternate outcome" style="text;align=left;fontSize=13;fontStyle=1;fontColor=#43566f;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1685" width="1520" height="28" />
        </mxCell>
        <mxCell id="bf06-note" value="&lt;b&gt;Document &amp;amp; Posting Semantics (BF-06):&lt;/b&gt; Sequence is &lt;b&gt;Customer Custody (CUS-IN) → Warehouse Inspection (UC-72) → Store Owner Acceptance (UC-71) → Per-quantity Receipt/Handback (UC-73)&lt;/b&gt;. &lt;b&gt;D6 rules (BR-29):&lt;/b&gt; sealed boxes and unused loose pieces are assessed case-by-case; installed, customer-damaged, or confirmed overdue goods are rejected; unverified deadlines remain &lt;b&gt;PENDING&lt;/b&gt; (&lt;b&gt;no invented return-day policy&lt;/b&gt;). Example: 10 boxes returned → 7 GOOD accepted (&lt;b&gt;GR-CR + TO-PUTAWAY&lt;/b&gt;), 2 supplier-defective accepted (&lt;b&gt;GR-CR quarantine → BF-02/07&lt;/b&gt;), 1 rejected (&lt;b&gt;custody → CUS-OUT handback&lt;/b&gt;). Refunds/invoices stay in MISA; WMSD records external references only (UC-108)." style="rounded=1;fillColor=#f3f5f8;strokeColor=#d6dde6;align=left;spacing=12;fontSize=13;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1720" width="1520" height="160" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="BF-07" name="BF-07">
    <mxGraphModel dx="1440" dy="1880" grid="1" gridSize="10" page="1" pageWidth="1440" pageHeight="1880" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bf07-title" value="BF-07 — Supplier return and quantity reconciliation" style="text;align=left;fontSize=24;fontStyle=1;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1360" height="42" />
        </mxCell>
        <mxCell id="bf07-subtitle" value="To-be D1–D8 • Updated 21 Oct 2026 • Authoritative specification: docs/02_nghiep_vu/de_xuat_quy_trinh_2_EN.md (Sections 4, 15, 16)" style="text;align=left;fontSize=13;fontColor=#58677c;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="64" width="1360" height="28" />
        </mxCell>
        <mxCell id="bf07-lane-wh" value="Warehouse Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="110" width="460" height="1510" />
        </mxCell>
        <mxCell id="bf07-lane-acc" value="Accountant" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="500" y="110" width="450" height="1510" />
        </mxCell>
        <mxCell id="bf07-lane-owner" value="Store Owner" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="950" y="110" width="450" height="1510" />
        </mxCell>

        <!-- Row 1: Propose Supplier Return & Record supplier agreement -->
        <mxCell id="bf07-s1" value="&lt;b&gt;1. Propose Supplier Return (SR) &amp;amp; isolate/reserve stock&lt;/b&gt;&lt;br&gt;Link to supplier, source PO/GR, lot/location &amp;amp; evidence; separate store-owned stock vs supplier custody&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;SR • UC-81 [BF-07-E1]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-wh">
          <mxGeometry as="geometry" x="65" y="66" width="330" height="94" />
        </mxCell>
        <mxCell id="bf07-s2" value="&lt;b&gt;2. Verify documents &amp;amp; record supplier agreement&lt;/b&gt;&lt;br&gt;Record agreed/refused quantity, schedule &amp;amp; handover method (Owner/staff may contact externally per Q20)&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Supplier Agreement • UC-107 [BR-20]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-acc">
          <mxGeometry as="geometry" x="60" y="66" width="330" height="94" />
        </mxCell>

        <!-- Row 2: Supplier agreement decision & Refusal handling -->
        <mxCell id="bf07-d1" value="&lt;b&gt;Supplier agrees&lt;br&gt;to return?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;[BF-07-A1]&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-acc">
          <mxGeometry as="geometry" x="115" y="206" width="220" height="92" />
        </mxCell>
        <mxCell id="bf07-a1" value="&lt;b&gt;[BF-07-A1] Supplier pending, refusal or partial agreement&lt;/b&gt;&lt;br&gt;Prepare only agreed &amp;amp; Owner-authorized quantities. Refused defective goods remain isolated in &lt;b&gt;BF-02&lt;/b&gt; (never made sellable by refusal)." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-wh">
          <mxGeometry as="geometry" x="65" y="204" width="330" height="96" />
        </mxCell>

        <!-- Row 3: Owner dispatch authorization (or reuse BF-02 DISP) -->
        <mxCell id="bf07-s3" value="&lt;b&gt;3. Authorize return dispatch or reuse valid BF-02 decision&lt;/b&gt;&lt;br&gt;Reuse BF-02 supplier-return approval only if case/version/scope/quantity matches; do not approve twice&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Dispatch Authorization • UC-106 [BF-07-A2, BR-05]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-owner">
          <mxGeometry as="geometry" x="60" y="346" width="330" height="96" />
        </mxCell>

        <!-- Row 4: Prepare & Pick return issue -->
        <mxCell id="bf07-s4" value="&lt;b&gt;4. Pick, count &amp;amp; draft return issue&lt;/b&gt;&lt;br&gt;Requires BOTH internal Owner authorization &amp;amp; supplier agreement; revise unexecuted scope if short pick&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;GI-SR / CUS-OUT draft • UC-82 [BF-07-A1, E1, BR-20]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-wh">
          <mxGeometry as="geometry" x="65" y="490" width="330" height="94" />
        </mxCell>

        <!-- Row 5: Hand over & Post dispatch (GI-SR vs CUS-OUT) -->
        <mxCell id="bf07-s5" value="&lt;b&gt;5. Physically hand over &amp;amp; post return dispatch once&lt;/b&gt;&lt;br&gt;&lt;b&gt;GI-SR&lt;/b&gt; deducts store-owned stock once; arrival-rejected supplier goods in custody release &lt;b&gt;CUS-OUT&lt;/b&gt; only&lt;br&gt;&lt;font color=&quot;#2b5b42&quot;&gt;GI-SR (POSTED) or CUS-OUT + HO • UC-82 [BF-07-E1, BR-06, BR-20]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-wh">
          <mxGeometry as="geometry" x="45" y="620" width="370" height="116" />
        </mxCell>

        <!-- Row 6: Accountant records supplier ACK & compares quantities -->
        <mxCell id="bf07-s6" value="&lt;b&gt;6. Record supplier receipt acknowledgement (ACK)&lt;/b&gt;&lt;br&gt;Compare dispatched vs acknowledged quantities; never rewrite posted GI-SR to match supplier ACK&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;ACK / VAR • UC-107 [BF-07-E2]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-acc">
          <mxGeometry as="geometry" x="60" y="776" width="330" height="94" />
        </mxCell>

        <!-- Row 7: Reconciliation decision & Variance resolution -->
        <mxCell id="bf07-d2" value="&lt;b&gt;Dispatched vs ACK&lt;br&gt;quantities matched?&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#58677c&quot;&gt;[BF-07-E2]&lt;/font&gt;" style="rhombus;fontSize=13;spacing=6;strokeWidth=1.5;fillColor=#fff8e6;strokeColor=#b7811f;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-acc">
          <mxGeometry as="geometry" x="115" y="916" width="220" height="94" />
        </mxCell>
        <mxCell id="bf07-s7a" value="&lt;b&gt;7a. Approve supplier-return variance resolution&lt;/b&gt;&lt;br&gt;Resolve short/damaged/refused ACK; returned-back goods need actual receipt/inspection to increase stock&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Variance Resolution • UC-106 [BF-07-E2]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-owner">
          <mxGeometry as="geometry" x="60" y="916" width="330" height="94" />
        </mxCell>

        <!-- Row 8: Execute returned-back receipt if any & Reconcile external settlement -->
        <mxCell id="bf07-e2" value="&lt;b&gt;[BF-07-E2 / A3] Returned-back goods or replacement&lt;/b&gt;&lt;br&gt;Goods coming back require actual inspection &amp;amp; linked receipt. Supplier replacements use a new linked &lt;b&gt;BF-01 arrival / GR-P&lt;/b&gt; (never increase stock from agreement/money)." style="rounded=1;arcSize=10;fontSize=12;spacing=8;strokeWidth=1.5;fillColor=#fef6f6;strokeColor=#b85c5c;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-wh">
          <mxGeometry as="geometry" x="65" y="1060" width="330" height="98" />
        </mxCell>
        <mxCell id="bf07-s7b" value="&lt;b&gt;7b. Record external financial / credit / replacement references&lt;/b&gt;&lt;br&gt;Reconcile external MISA settlement; financial status remains independent of warehouse closure&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;External references • UC-108 [BF-07-A3, BR-26]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-acc">
          <mxGeometry as="geometry" x="60" y="1060" width="330" height="98" />
        </mxCell>

        <!-- Row 9: Close Supplier Return -->
        <mxCell id="bf07-s8" value="&lt;b&gt;8. Close Supplier Return when all quantities are accounted for&lt;/b&gt;&lt;br&gt;Verify every dispatched quantity is reconciled; ACK and closure never deduct stock a second time&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;SR CLOSED • UC-83 [BR-20]&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=13;spacing=8;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="bf07-lane-owner">
          <mxGeometry as="geometry" x="60" y="1214" width="330" height="94" />
        </mxCell>

