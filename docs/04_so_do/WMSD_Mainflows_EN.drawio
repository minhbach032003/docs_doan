              <mxPoint x="1325" y="1270" />
              <mxPoint x="945" y="1270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bf01-e-e1-7" value="Reconcile discrepancy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#b85c5c;strokeWidth=1.5;fontSize=11;fontColor=#8a3b3b;fontFamily=Arial;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bf01-e1" target="bf01-s7">
