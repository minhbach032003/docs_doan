        <mxCell id="legend" value="Blue: action/document • Green: action that may post inventory or custody movements" style="text;align=left;fontSize=13;fontColor=#43566f;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1279" width="1320" height="35" />
        </mxCell>
        <mxCell id="note" value="D6: sealed boxes/unused loose tiles are case-by-case. Reject installed, customer-damaged or confirmed overdue goods.&lt;br&gt;Unverified conditions/deadline: pending, no GR-CR. Do not invent return days. Physically received but rejected goods remain custody until handback; proven ineligible requests may be rejected before intake.&lt;br&gt;CUS-IN does not increase owned stock. GR-CR uses the approved assessment version. Supplier-defective goods may enter quarantine. Refunds stay in MISA; WMS records references." style="rounded=1;fillColor=#f3f5f8;strokeColor=#d6dde6;align=left;spacing=12;fontSize=13;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1322" width="1320" height="170" />
        </mxCell>
