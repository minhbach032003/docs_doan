          <mxGeometry as="geometry" x="700.0" y="115" width="330.0" height="1146" />
        </mxCell>
        <mxCell id="step-0" value="&lt;b&gt;1. Nhập yêu cầu từ đơn nguồn&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;WIR&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-sales">
          <mxGeometry as="geometry" x="25.0" y="66" width="280" height="86" />
        </mxCell>
        <mxCell id="step-1" value="&lt;b&gt;2. Chọn nguồn và đợt giao¹&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;OD / allocation&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-sales">
          <mxGeometry as="geometry" x="25.0" y="198" width="280" height="86" />
        </mxCell>
        <mxCell id="step-2" value="&lt;b&gt;3. Giữ hàng; giao việc soạn&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Reservation / TO-PICK&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="330" width="280" height="86" />
        </mxCell>
        <mxCell id="step-3" value="&lt;b&gt;4. Soạn; xác nhận về staging&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;TO confirmation&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="462" width="280" height="86" />
        </mxCell>
        <mxCell id="step-4" value="&lt;b&gt;5. Kiểm cuối; lập phiếu xuất&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;GI-S draft&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="594" width="280" height="86" />
        </mxCell>
        <mxCell id="step-5" value="&lt;b&gt;6. Bàn giao thực tế; PGI&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;GI-S + HO&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="726" width="280" height="86" />
        </mxCell>
        <mxCell id="step-6" value="&lt;b&gt;7. Theo dõi phần đã giao/còn thiếu&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;WIR / OD&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-sales">
