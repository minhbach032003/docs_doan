        <mxCell id="step-4" value="&lt;b&gt;5. Execute authorized outcome¹&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;SCRAP / Movement / SR&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
