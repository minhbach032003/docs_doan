        <mxCell id="step-1" value="&lt;b&gt;2. Block allocation; isolate immediately&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;TO-QUARANTINE&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
