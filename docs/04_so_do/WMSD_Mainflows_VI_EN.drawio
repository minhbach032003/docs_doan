        <mxCell id="note" value="D6: nguyên thùng/viên lẻ chưa dùng xét từng trường hợp. Không nhận đã thi công, hỏng do khách hoặc đã xác minh quá hạn.&lt;br&gt;Chưa rõ điều kiện/thời hạn: chờ xác minh, không post GR-CR. Không tự đặt số ngày. Đã nhận vật lý nhưng bị từ chối: custody rồi bàn giao lại; có thể từ chối trước tiếp nhận nếu đã đủ căn cứ.&lt;br&gt;CUS-IN chưa tăng tồn sở hữu. GR-CR chỉ theo phiên bản đánh giá được duyệt. Lỗi do NCC có thể được nhận vào cách ly. Hoàn tiền trên MISA; WMS lưu tham chiếu." style="rounded=1;fillColor=#f3f5f8;strokeColor=#d6dde6;align=left;spacing=12;fontSize=13;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1322" width="1320" height="170" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="BF-07-VI" name="BF-07 VI">
    <mxGraphModel dx="1070" dy="1485" grid="1" gridSize="10" page="1" pageWidth="1070" pageHeight="1485" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="BF-07 — Trả nhà cung cấp và đối chiếu" style="text;align=left;fontSize=25;fontStyle=1;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="990" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="To-be D1–D8 • 20/10/2026 • Chi tiết/ngoại lệ: de_xuat_quy_trinh_2_VI.md, mục 4" style="text;align=left;fontSize=13;fontColor=#58677c;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="66" width="990" height="30" />
        </mxCell>
        <mxCell id="lane-wh" value="Nhân viên kho" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40.0" y="115" width="330.0" height="1146" />
        </mxCell>
        <mxCell id="lane-acc" value="Kế toán" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370.0" y="115" width="330.0" height="1146" />
        </mxCell>
        <mxCell id="lane-owner" value="Chủ cửa hàng" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700.0" y="115" width="330.0" height="1146" />
        </mxCell>
        <mxCell id="step-0" value="&lt;b&gt;1. Đề nghị trả; giữ đúng nguồn&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;SR&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="66" width="280" height="86" />
        </mxCell>
        <mxCell id="step-1" value="&lt;b&gt;2. Ghi NCC đồng ý nhận hàng&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Agreement / evidence&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-acc">
          <mxGeometry as="geometry" x="25.0" y="198" width="280" height="86" />
        </mxCell>
        <mxCell id="step-2" value="&lt;b&gt;3. Duyệt xuất hoặc dùng DISP hợp lệ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Approval&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-owner">
          <mxGeometry as="geometry" x="25.0" y="330" width="280" height="86" />
        </mxCell>
        <mxCell id="step-3" value="&lt;b&gt;4. Soạn và bàn giao thực tế&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;GI-SR / CUS-OUT + HO&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="462" width="280" height="86" />
        </mxCell>
        <mxCell id="step-4" value="&lt;b&gt;5. Ghi NCC xác nhận nhận&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;ACK / VAR&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-acc">
          <mxGeometry as="geometry" x="25.0" y="594" width="280" height="86" />
        </mxCell>
        <mxCell id="step-5" value="&lt;b&gt;6. Duyệt sai lệch nếu có¹&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Resolution approval&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-owner">
          <mxGeometry as="geometry" x="25.0" y="726" width="280" height="86" />
        </mxCell>
        <mxCell id="step-6" value="&lt;b&gt;7. Đối chiếu kết quả bên ngoài&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;External references&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-acc">
          <mxGeometry as="geometry" x="25.0" y="858" width="280" height="86" />
        </mxCell>
        <mxCell id="step-7" value="&lt;b&gt;8. Đóng khi mọi lượng đã rõ¹&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;SR CLOSED&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-owner">
