        <mxCell id="step-0" value="&lt;b&gt;1. Kiểm nguồn và điều kiện D6&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;CR&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-sales">
