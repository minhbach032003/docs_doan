          <mxGeometry as="geometry" x="700.0" y="115" width="330.0" height="1146" />
        </mxCell>
        <mxCell id="step-0" value="&lt;b&gt;1. Request return; isolate source quantity&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;SR&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="66" width="280" height="86" />
        </mxCell>
        <mxCell id="step-1" value="&lt;b&gt;2. Record supplier agreement&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Agreement / evidence&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-acc">
          <mxGeometry as="geometry" x="25.0" y="198" width="280" height="86" />
        </mxCell>
        <mxCell id="step-2" value="&lt;b&gt;3. Authorize dispatch or reuse valid DISP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Approval&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-owner">
          <mxGeometry as="geometry" x="25.0" y="330" width="280" height="86" />
        </mxCell>
        <mxCell id="step-3" value="&lt;b&gt;4. Prepare and physically hand over&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;GI-SR / CUS-OUT + HO&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="462" width="280" height="86" />
        </mxCell>
        <mxCell id="step-4" value="&lt;b&gt;5. Record supplier acknowledgement&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;ACK / VAR&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-acc">
          <mxGeometry as="geometry" x="25.0" y="594" width="280" height="86" />
        </mxCell>
        <mxCell id="step-5" value="&lt;b&gt;6. Approve variance resolution if any¹&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Resolution approval&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-owner">
          <mxGeometry as="geometry" x="25.0" y="726" width="280" height="86" />
        </mxCell>
        <mxCell id="step-6" value="&lt;b&gt;7. Reconcile external outcome&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;External references&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-acc">
          <mxGeometry as="geometry" x="25.0" y="858" width="280" height="86" />
        </mxCell>
        <mxCell id="step-7" value="&lt;b&gt;8. Close when all quantities are resolved¹&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;SR CLOSED&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-owner">
