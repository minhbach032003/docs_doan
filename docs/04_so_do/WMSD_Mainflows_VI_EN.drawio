        </mxCell>
        <mxCell id="step-2" value="&lt;b&gt;3. Pick and check at source&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;TO-PICK / TD draft&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-src">
          <mxGeometry as="geometry" x="25.0" y="330" width="280" height="86" />
        </mxCell>
