        </mxCell>
        <mxCell id="lane-owner" value="Store Owner" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370.0" y="115" width="330.0" height="1014" />
        </mxCell>
        <mxCell id="lane-acc" value="Accountant" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700.0" y="115" width="330.0" height="1014" />
        </mxCell>
        <mxCell id="lane-wh" value="Warehouse Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1030.0" y="115" width="330.0" height="1014" />
        </mxCell>
        <mxCell id="step-0" value="&lt;b&gt;1. Record shortage demand¹&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;RR&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-sales">
          <mxGeometry as="geometry" x="25.0" y="66" width="280" height="86" />
        </mxCell>
        <mxCell id="step-1" value="&lt;b&gt;2. Approve demand and quantity&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Approval&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-owner">
          <mxGeometry as="geometry" x="25.0" y="198" width="280" height="86" />
        </mxCell>
        <mxCell id="step-2" value="&lt;b&gt;3. Create PO; record supplier confirmation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;PO&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-acc">
          <mxGeometry as="geometry" x="25.0" y="330" width="280" height="86" />
        </mxCell>
        <mxCell id="step-3" value="&lt;b&gt;4. Inspect; record co-inspectors&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;ARR / INS / VAR&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="462" width="280" height="86" />
        </mxCell>
        <mxCell id="step-4" value="&lt;b&gt;5. Post accepted quantities&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;GR-P / CUS-IN&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="594" width="280" height="86" />
        </mxCell>
        <mxCell id="step-5" value="&lt;b&gt;6. Put away; confirm locations&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;TO-PUTAWAY&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="726" width="280" height="86" />
        </mxCell>
        <mxCell id="step-6" value="&lt;b&gt;7. Reconcile; track remainder²&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;PO ↔ GR&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-acc">
          <mxGeometry as="geometry" x="25.0" y="858" width="280" height="86" />
        </mxCell>
        <mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step-0" target="step-1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="205.0" y="290" />
              <mxPoint x="535.0" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step-1" target="step-2">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="535.0" y="422" />
              <mxPoint x="865.0" y="422" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step-2" target="step-3">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="865.0" y="554" />
              <mxPoint x="1195.0" y="554" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step-3" target="step-4">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#667a92;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step-4" target="step-5">
