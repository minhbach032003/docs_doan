              <mxPoint x="865.0" y="950" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="legend" value="Blue: action/document • Green: action that may post inventory or custody movements" style="text;align=left;fontSize=13;fontColor=#43566f;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1147" width="1320" height="35" />
        </mxCell>
        <mxCell id="note" value="¹ Warehouse Staff raises RR for storage demand. ² Owner approves undelivered-remainder cancellation. No accepted quantity: keep case open, no GR.&lt;br&gt;Owner/Accountant may assist; Warehouse still confirms/posts. Torn packaging alone is not tile damage; count pieces left in opened boxes." style="rounded=1;fillColor=#f3f5f8;strokeColor=#d6dde6;align=left;spacing=12;fontSize=13;fontColor=#34465e;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
