        <mxCell id="title" value="BF-01 — Replenishment, purchase and receipt" style="text;align=left;fontSize=25;fontStyle=1;fontColor=#17304d;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1320" height="45" />
        </mxCell>
        <mxCell id="subtitle" value="To-be D1–D8 • 20 Oct 2026 • Details/exceptions: de_xuat_quy_trinh_2_EN.md, section 4" style="text;align=left;fontSize=13;fontColor=#58677c;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="66" width="1320" height="30" />
        </mxCell>
        <mxCell id="lane-sales" value="Sales Staff" style="swimlane;horizontal=1;startSize=46;collapsible=0;container=1;fontSize=17;fontStyle=1;fillColor=#edf2f7;swimlaneFillColor=#fafbfd;strokeColor=#c9d3df;pointerEvents=0;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="1">
