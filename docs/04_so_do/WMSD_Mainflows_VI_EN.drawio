        <mxCell id="step-1" value="&lt;b&gt;2. Take custody pending decision&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;CUS-IN&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="198" width="280" height="86" />
        </mxCell>
        <mxCell id="step-2" value="&lt;b&gt;3. Inspect each quantity and D6&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;INS&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="330" width="280" height="86" />
        </mxCell>
        <mxCell id="step-3" value="&lt;b&gt;4. Decide D6-eligible quantities&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Approval&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-owner">
          <mxGeometry as="geometry" x="25.0" y="462" width="280" height="86" />
        </mxCell>
        <mxCell id="step-4" value="&lt;b&gt;5. Receive accepted; hand back rejected&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;GR-CR / CUS-OUT&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="594" width="280" height="86" />
        </mxCell>
        <mxCell id="step-5" value="&lt;b&gt;6. Put away good; isolate damaged&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;TO / DC&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#e8f4ed;strokeColor=#438463;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
          <mxGeometry as="geometry" x="25.0" y="726" width="280" height="86" />
        </mxCell>
        <mxCell id="step-6" value="&lt;b&gt;7. Communicate warehouse outcome&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;CR warehouse status&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-sales">
          <mxGeometry as="geometry" x="25.0" y="858" width="280" height="86" />
        </mxCell>
        <mxCell id="step-7" value="&lt;b&gt;8. Record external financial follow-up&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;External references&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-acc">
