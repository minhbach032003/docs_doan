        <mxCell id="step-1" value="&lt;b&gt;2. Activate freeze; obtain count sheet&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#43566f&quot;&gt;Snapshot / COUNT&lt;/font&gt;" style="rounded=1;arcSize=12;fontSize=15;spacing=10;strokeWidth=1.5;fillColor=#eaf1fb;strokeColor=#6b88ac;html=1;fontFamily=Arial;whiteSpace=wrap;" vertex="1" parent="lane-wh">
