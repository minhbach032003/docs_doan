  <diagram id="page_d7_inventory" name="7. Tồn kho &amp; Kiểm kê">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2410" pageHeight="1540" math="0" shadow="0">
