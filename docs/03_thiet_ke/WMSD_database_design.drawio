        <mxCell id="vdep_0" value="FROM wmsd.stock_movement (from_balance_id / to_balance_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;startArrow=none;endArrow=open;endFill=0;strokeColor=#555555;strokeWidth=1.5;" edge="1" parent="1" source="view_inventory_ledger" target="stub_page_d8_views__stock_movement">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vdep_1" value="FROM wmsd.stock_balance b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;startArrow=none;endArrow=open;endFill=0;strokeColor=#555555;strokeWidth=1.5;exitX=1;exitY=0.1;exitDx=0;exitDy=0;" edge="1" parent="1" source="view_available_stock" target="stub_page_d8_views__stock_balance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vdep_2" value="JOIN wmsd.stock_account a ON a.account_id = b.account_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;startArrow=none;endArrow=open;endFill=0;strokeColor=#555555;strokeWidth=1.5;exitX=1;exitY=0.2;exitDx=0;exitDy=0;" edge="1" parent="1" source="view_available_stock" target="stub_page_d8_views__stock_account">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vdep_3" value="JOIN wmsd.location l ON l.location_id = a.location_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;startArrow=none;endArrow=open;endFill=0;strokeColor=#555555;strokeWidth=1.5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;" edge="1" parent="1" source="view_available_stock" target="stub_page_d8_views__location">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vdep_4" value="JOIN wmsd.warehouse w ON w.warehouse_id = l.warehouse_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;startArrow=none;endArrow=open;endFill=0;strokeColor=#555555;strokeWidth=1.5;exitX=1;exitY=0.4;exitDx=0;exitDy=0;" edge="1" parent="1" source="view_available_stock" target="stub_page_d8_views__warehouse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vdep_5" value="JOIN wmsd.party p ON p.party_id = b.owner_party_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;startArrow=none;endArrow=open;endFill=0;strokeColor=#555555;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="view_available_stock" target="stub_page_d8_views__party">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vdep_6" value="JOIN wmsd.lot lot_ref ON lot_ref.lot_id = b.lot_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;startArrow=none;endArrow=open;endFill=0;strokeColor=#555555;strokeWidth=1.5;exitX=1;exitY=0.6;exitDx=0;exitDy=0;" edge="1" parent="1" source="view_available_stock" target="stub_page_d8_views__lot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vdep_7" value="JOIN wmsd.product pr ON pr.product_id = lot_ref.product_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;startArrow=none;endArrow=open;endFill=0;strokeColor=#555555;strokeWidth=1.5;exitX=1;exitY=0.7;exitDx=0;exitDy=0;" edge="1" parent="1" source="view_available_stock" target="stub_page_d8_views__product">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vdep_8" value="LEFT JOIN wmsd.reservation r (status='ACTIVE')" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;startArrow=none;endArrow=open;endFill=0;strokeColor=#555555;strokeWidth=1.5;exitX=1;exitY=0.8;exitDx=0;exitDy=0;" edge="1" parent="1" source="view_available_stock" target="stub_page_d8_views__reservation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="vdep_9" value="NOT EXISTS wmsd.location_lock k" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=6 4;fontSize=10;fontStyle=2;fontColor=#333333;labelBackgroundColor=#ffffff;startArrow=none;endArrow=open;endFill=0;strokeColor=#555555;strokeWidth=1.5;exitX=1;exitY=0.9;exitDx=0;exitDy=0;" edge="1" parent="1" source="view_available_stock" target="stub_page_d8_views__location_lock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
